repeat
return

* gcat.match - acc.name, path, m in; "gcat:" lines added to m for every
*   gcat entry that came from one of this account's object files.
gcat.match:
if gcat.ids = '' then return
openpath path:@ds:'voc' to voc.f else
display sysmsg(13011, path:@ds:'voc', acc.name)
return
end
* Select lists 11 and 12 only: 13 and up are out of range (measured, 1 Oct 26).
*   gcat.load's 12 is finished by now; the account loop holds no list.
select voc.f to 11
loop
readnext vid from 11 else exit
read vrec from voc.f, vid else continue
if upcase(vrec[1,1]) # 'F' then continue
rel = vrec<2,1>
if downcase(rel[len(rel) - 3, 4]) # '.out' then continue
if rel[1,1] = @ds then opath = rel else opath = path:@ds:rel
openpath opath to obj.f else
display sysmsg(13011, opath, acc.name)
continue
end
mark.mapping obj.f, off
select obj.f to 12
loop
readnext oid from 12 else exit
read src from obj.f, oid else continue
if len(src) < object.header.size then continue
if src[hdr.magic, 1] # char(hdr.magic.no.l) and src[hdr.magic, 1] # char(hdr.magic.no.b) then continue
locate src[hdr.compile.time, 4] in gcat.times<1> setting gpos else continue
full = oconv(src[hdr.object.size, 4], 'IL')
cut = full
s.off = oconv(src[hdr.sym.tab.offset, 4], 'IL')
l.off = oconv(src[hdr.lin.tab.offset, 4], 'IL')
if s.off > 0 and s.off < cut then cut = s.off
if l.off > 0 and l.off < cut then cut = l.off
* Every gcat entry with that compile time is a candidate, not only the first.
for g = 1 to dcount(gcat.times, @fm)
if gcat.times<g> # src[hdr.compile.time, 4] then continue
read gobj from gcat.f, gcat.ids<g> else continue
if len(gobj) # cut and len(gobj) # full then continue
a = src[1, 16]:src[hdr.flags, 8]:src[object.header.size, cut - object.header.size + 1]
b = gobj[1, 16]:gobj[hdr.flags, 8]:gobj[object.header.size, cut - object.header.size + 1]
if a = b then
line = 'gcat: ':gcat.ids<g>:' = ':rel:' ':oid
if len(gobj) = cut and cut < full then line := ' noxref'
m<-1> = line
end
next g
repeat
close obj.f
repeat
close voc.f
return

end

