* END-HISTORY
*
* START-DESCRIPTION:
*
*    call !settings_os(lines, err)
*
*    lines: the report text, one line per field, each section headed [name];
*    a section with nothing to say is left out.  NEVER A SECRET: no password,
*    no key, nothing read from $cred beyond whether a record exists - the API
*    certificate's fields come from openssl x509 -noout.
*
*    [sd.conf]   the configuration file SD read (SD_CONFIG, else <home>/sd.conf)
*    [policy]    <home>/solo.policy, the install-time choices (denied verbs ...)
*    [mode]      standalone, or managed when $cred holds the $global record
*    [api]       the API listener (sd-solo-api.socket) and the certificate's
*                subject, dates and fingerprint (<config dir>/sd-tls/api.pem)
*    [ssh]       sshd's Match / ForceCommand lines that name SD Solo
*    [service]   sd-solo.service and sd-solo-api.socket, enabled / active, and
*                whether the user lingers (SD outlives a sign-out)
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine settings_os(lines, err)
$catalog !settings_os

$include int$keys.h

   lines = ''
   err = ''

* [sd.conf]
   conf = env('SD_CONFIG')
   if conf = '' then conf = @sdsys:@ds:'sd.conf'
   path = conf ; gosub read.file
   hdr = '[sd.conf] ':conf ; gosub add.section

* [policy]
   path = @sdsys:@ds:'solo.policy' ; gosub read.file
   hdr = '[policy] ':path ; gosub add.section

* [mode]
   sec = 'standalone'
   openpath @sdsys:@ds:'$cred' to cred.f then
      read x from cred.f, '$global' then sec = 'managed (a global password is set)'
      close cred.f
   end
   hdr = '[mode]' ; gosub add.section

* [api]
   cmd = 'systemctl --user show -p Listen -p UnitFileState -p ActiveState sd-solo-api.socket 2>&1'
   gosub run.cmd
   sec = out
   tls = field(conf, @ds, 1, dcount(conf, @ds) - 1):@ds:'sd-tls':@ds:'api.pem'
   if index(tls, "'", 1) = 0 then
      cmd = "openssl x509 -noout -subject -startdate -enddate -fingerprint -sha256 -in '":tls:"' 2>&1"
      gosub run.cmd
      sec<-1> = out
   end
   hdr = '[api]' ; gosub add.section

* [ssh]
   cmd = "grep -H -i -E '^[[:space:]]*(Port|AllowGroups|Match|ForceCommand)[[:space:]]' /etc/ssh/sshd_config.d/*sd-solo*.conf 2>/dev/null"
   gosub run.cmd
   sec = out
   hdr = '[ssh]' ; gosub add.section

* [service]
   sec = ''
   for u = 1 to 2
      unit = if u = 1 then 'sd-solo.service' else 'sd-solo-api.socket'
      cmd = 'systemctl --user is-enabled ':unit:' 2>&1'
      gosub run.cmd
      en = out<1>
      cmd = 'systemctl --user is-active ':unit:' 2>&1'
      gosub run.cmd
      sec<-1> = unit:': ':en:', ':out<1>
   next u
   cmd = 'loginctl show-user "$(id -un)" -p Linger 2>&1'
   gosub run.cmd
   sec<-1> = out<1>
   hdr = '[service]' ; gosub add.section
   return

* ======================================================================
read.file:
   sec = ''
   openseq path to f then
      loop
         readseq line from f else exit
         sec<-1> = line
      repeat
      closeseq f
   end else
      sec<-1> = path:': cannot be read (status ':status():')'
   end
   return

* run.cmd - cmd in, out (fields) out; a failure says so with its status.
run.cmd:
   out = ''
   os.execute cmd capturing out
   stat = os.error()
   if out[len(out),1] = @fm then out = out[1, len(out) - 1]
   if stat # 0 and out = '' then out = '(exit status ':stat:')'
   return

* add.section - hdr and sec in; appended to lines if sec has anything.
add.section:
   if trim(convert(@fm, '', sec)) # '' then
      if lines # '' then lines<-1> = ''
      lines<-1> = hdr
      lines<-1> = sec
   end
   return

end

* END-CODE
