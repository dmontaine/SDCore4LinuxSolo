* SOLOJOB
* SET.JOB verb: SD's own scheduled jobs for SD Core for Linux Solo - defined, changed, deleted and started as systemd user timers.
* Copyright (c) 2026, SD Core for Linux Solo.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 17 Nov 26 dm  New (S.247; owner, 15 Nov 2026: "since scheduled jobs is in core and useful in solo it should be in this release", and of the plan
*               .claude/plan-s247-solo-jobs.md, "your plan is fine": off as delivered, a job made only with the password typed, its command fixed
*               then, the user's own timers).  SD Core for Linux's SET.JOB is the template for the verb's words (list, add, change, delete, run), the
*               name rule, the five schedules and their OnCalendar; what differs is forced by Solo having no root and one user: a job's command is the
*               user's own SD command, not an id from the root helper's list, the units are the user's own (~/.config/systemd/user), and the
*               definitions are a private file of the tree ($jobs) rather than root's.  Listed for the parity audit.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SET.JOB                                   lists the jobs, each with its schedule, its command, its next run and its last run
*   SET.JOB ADD name schedule command         defines a new job (refused when a job of that name exists)
*   SET.JOB CHANGE name schedule command      changes an existing job (refused when there is none)
*   SET.JOB DELETE name                       stops and removes a job
*   SET.JOB RUN name                          starts a job now, exactly as its timer would
*   SET.JOB RESTORE                           (the installer's internal session only) gives every kept definition its timer again
*   SET.JOB HANDOVER                          (the scheduled jobs page, tool.jobs) ADD or CHANGE from the page's hand-over file, read and removed here:
*                                             the command and the password the person typed in the page's form, checked exactly as typed ones are
*
*     name       1 to 32 characters: a lower case letter first, then lower case letters, digits and dashes, not ending in a dash
*     schedule   every 5|10|15|20|30 minutes, hourly, daily hh:mm, weekly mon..sun hh:mm, monthly 1..28 hh:mm (the machine's time; hh.mm is taken too)
*     command    the rest of the line: the SD command the job runs, as typed - one line of printable characters, at most 500, not RUN.JOB or SET.JOB
*
*   OFF AS DELIVERED: ADD, CHANGE, RUN and RESTORE need the register's jobs switch (field 23, ACC$JOBS), which the administrator turns on with
*   SET.JOBS.ACCESS ON.  The list and DELETE work with it off, so a job can always be seen and taken away.
*
*   THE PASSWORD, TYPED: ADD and CHANGE ask for the account password at a terminal, every time, even in a session that has signed in; a one-shot
*   "sd-solo 'set.job add ...'" and a session with no terminal are refused (14941).  So a job's command is fixed by the person who knows the password,
*   at the moment it is set, and nothing that only runs as the user unattended can make one.
*
*   WHAT A JOB IS: two systemd user units, ~/.config/systemd/user/sd-solo-job-<name>.timer and .service.  The service runs the one-shot
*   <tree>/bin/sd-solo "run.job <name>", which signs in with the kept copy of the account password ($stored) as every one-shot does, and RUN.JOB reads
*   the command from the definition and runs it.  The command is never in a unit file, so nothing in it is quoted for systemd.  A run missed while
*   the computer was off is not made up (Persistent=false, as SD Core's).  Jobs run while the user's systemd manager runs: with linger on (the
*   installer's default) that is always.
*
*   NOT A WALL AGAINST THE USER: the definitions ($jobs, a directory of mode 0700) and the units belong to the user, who can edit them, as they can
*   edit the BASIC.  A job adds no way in that a one-shot does not already have (the plan, "The fact that shapes it").
*
*   Every change asked for is written to the audit trail with its result, in lower case; the command as typed.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set.job
$catalog $solojob

$include int$keys.h
$include keys.h
$include err.h

$define MAX.CMD    500
$define UNIT.PFX   'sd-solo-job-'
$define SYSTEMCTL  'LC_ALL=C systemctl --user'

   @system.return.code = -ER$ARGS
   acc.name = 'sduser'          ;* Solo's one account (ruling 29)

   sent = @sentence
   gosub split.words
   action = downcase(wd<2>)
   jname = downcase(wd<3>)

   gosub paths.ok
   if not(ok) then
      @system.return.code = -ER$FAILED
      stop sysmsg(14930, why)                                    ;* The job definitions could not be read or written (%1); nothing was changed
   end

   if n.words = 1 then
      gosub list.jobs
      @system.return.code = 0
      stop
   end

   ok.form = @false
   if (action = 'delete' or action = 'run') and n.words = 3 then ok.form = @true
   if (action = 'add' or action = 'change') and n.words >= 5 then ok.form = @true
   if action = 'restore' and n.words = 2 then ok.form = @true
   if action = 'handover' and n.words = 2 then ok.form = @true
   if not(ok.form) then stop sysmsg(14945)                       ;* Syntax: set.job ...

*  HANDOVER: the scheduled jobs page (tool.jobs) cannot pass a command with spaces and quotes, or a password, on a $tk_run line, so it writes them to
*  its hand-over file and runs SET.JOB HANDOVER; the file is read and removed here, whatever happens, and everything in it is checked exactly as if it
*  had been typed - the password included, which the person typed in the page's masked field.
   ho = @false
   ho.pw = ''
   if action = 'handover' then
      gosub read.handover
      if not(ho.ok) then
         @system.return.code = -ER$FAILED
         stop sysmsg(14930, 'the hand-over file')
      end
      ho = @true
      action = ho.action
      jname = ho.name
   end

   if action = 'restore' then
      if not(kernel(K$INTERNAL, -1)) then stop sysmsg(14945)     ;* the installer's word, not a person's
      gosub restore.all
      stop
   end

   gosub name.ok
   if not(ok) then stop sysmsg(14944, jname[1, 40])              ;* %1 is not a job name ...

   if action # 'delete' then
      gosub switch.on
      if not(sw.on) then
         @system.return.code = -ER$PERM
         stop sysmsg(14948)                                       ;* Scheduled jobs are off on this computer ...
      end
   end

   gosub open.jobs
   if not(ok) then
      @system.return.code = -ER$FAILED
      stop sysmsg(14930, why)
   end
   there = @false
   read old.rec from jobs.f, jname then
      there = @true
   end else
      old.rec = ''
   end

   begin case
      case action = 'add' or action = 'change'
         gosub do.set
      case action = 'delete'
         gosub do.delete
      case action = 'run'
         gosub do.run
   end case
   close jobs.f
   @system.return.code = (if done then 0 else -ER$FAILED)
   stop

* ------------------------------------------------------------------------------------------------- the actions

* ADD and CHANGE.  The words after the name are the schedule (its first word says how many words it has) and then the command, as typed.
do.set:
   done = @false
   jcmd = ''
   if ho then
      sched = ho.sched
      jcmd = ho.cmd
   end else
      s1 = downcase(wd<4>)
      begin case
         case s1 = 'every'   ; ns = 3
         case s1 = 'hourly'  ; ns = 1
         case s1 = 'daily'   ; ns = 2
         case s1 = 'weekly'  ; ns = 3
         case s1 = 'monthly' ; ns = 3
         case 1              ; ns = 0
      end case
      if ns = 0 or n.words < 3 + ns + 1 then
         crt sysmsg(14943)                                       ;* The schedule is none of: ...
         return
      end
      sched = ''
      for i = 4 to 3 + ns
         sched := (if sched = '' then '' else ' ') : downcase(wd<i>)
      next i
      skip.n = 3 + ns
      gosub rest.after
      jcmd = rest
   end
   gosub sched.ok
   if not(ok) then
      crt sysmsg(14943)
      return
   end
   gosub cmd.ok
   if not(ok) then
      crt sysmsg(14942)                                          ;* A job's command is one line of printable characters ...
      return
   end

   if action = 'add' and there then
      crt sysmsg(14939, jname)                                   ;* A job named %1 already exists; nothing was changed
      return
   end
   if action = 'change' and not(there) then
      crt sysmsg(14938, jname)                                   ;* No job is named %1; nothing was changed
      return
   end

   gosub ask.password
   if not(pw.ok) then
      void kernel(K$AUDIT, 'set.job ' : action : ' name=' : jname : ' result=refused reason=' : pw.why)
      return
   end

   new.rec = sched : @fm : cal : @fm : jcmd : @fm : date() : @fm : time()
   wrote = @true
   write new.rec to jobs.f, jname on error wrote = @false
   if not(wrote) then
      crt sysmsg(14930, 'the definition')
      gosub audit.set
      return
   end

   u.sched = sched ; u.cal = cal
   gosub write.units
   if u.ok then gosub enable.timer
   if u.ok then
      done = @true
      crt sysmsg(14937, jname, sched)                            ;* Job %1 is scheduled: %2
   end else
*     Put back what was there: a new job leaves nothing; a changed one is given its old definition and timer again.
      if there then
         write old.rec to jobs.f, jname on error null
         u.sched = old.rec<1> ; u.cal = old.rec<2>
         gosub write.units
         if u.ok then gosub enable.timer
      end else
         delete jobs.f, jname on error null
         gosub remove.units
      end
      crt sysmsg(14933, u.rc)                                    ;* systemd did not do it (status %1) ...
   end
   gosub audit.set
   return

audit.set:
   void kernel(K$AUDIT, 'set.job ' : action : ' name=' : jname : ' schedule=' : sched : ' result=' : (if done then 'done' else 'failed') : ' command=' : jcmd)
   return

do.delete:
   done = @false
   if not(there) then
      gosub units.exist
      if not(u.any) then
         crt sysmsg(14938, jname)
         return
      end
   end
   gosub remove.units
   del.ok = @true
   if there then delete jobs.f, jname on error del.ok = @false
   if u.ok and del.ok then
      done = @true
      crt sysmsg(14936, jname)                                   ;* Job %1 is deleted
   end else
      if not(del.ok) then crt sysmsg(14930, 'the definition') else crt sysmsg(14933, u.rc)
   end
   void kernel(K$AUDIT, 'set.job delete name=' : jname : ' result=' : (if done then 'done' else 'failed'))
   return

do.run:
   done = @false
   if not(there) then
      crt sysmsg(14938, jname)
      return
   end
   cmd = SYSTEMCTL : ' start --no-block ' : UNIT.PFX : jname : '.service'
   gosub run.cmd
   gosub show.out
   if rc = 0 then
      done = @true
      crt sysmsg(14935, jname)                                   ;* Job %1 is started
   end else
      crt sysmsg(14933, rc)
   end
   void kernel(K$AUDIT, 'set.job run name=' : jname : ' result=' : (if done then 'done' else 'failed status=' : rc))
   return

* The installer's internal session, after a reload kept $jobs: every definition gets its units again.  Counted; one that fails is said and skipped.
restore.all:
   gosub open.jobs
   if not(ok) then
      crt sysmsg(14930, why)
      return
   end
   n.restored = 0
   sselect jobs.f to 11
   loop
      readnext jname from 11 else exit
      gosub name.ok
      if ok then
         read rec from jobs.f, jname then
            u.sched = rec<1> ; u.cal = rec<2>
            gosub write.units
            if u.ok then gosub enable.timer
            if u.ok then n.restored += 1 else crt jname : ': ' : sysmsg(14933, u.rc)
         end
      end
   repeat
   close jobs.f
   crt sysmsg(14929, n.restored)                                 ;* %1 job(s) given their timers again from the kept definitions
   void kernel(K$AUDIT, 'set.job restore count=' : n.restored)
   @system.return.code = 0
   return

* ------------------------------------------------------------------------------------------------- the list

list.jobs:
   gosub switch.on
   crt sysmsg(14947, (if sw.on then 'yes' else 'no'))            ;* SD's scheduled jobs (set.job, run.job) may be made and run: %1
   gosub open.jobs
   if not(ok) then
      crt sysmsg(14934)                                          ;* No scheduled job is defined
      return
   end
   n.listed = 0
   sselect jobs.f to 11
   loop
      readnext jname from 11 else exit
      gosub name.ok
      if ok then
         read rec from jobs.f, jname then
            n.listed += 1
            crt 'job ' : jname : ': ' : rec<1> : ': ' : rec<3>
            gosub job.state
            crt sysmsg(14931, nx, lr)                             ;* next run: %1; last run: %2
         end
      end
   repeat
   close jobs.f
   if n.listed = 0 then crt sysmsg(14934)
   return

* jname in (checked); nx and lr out: what the user's systemd says of the timer and the service.  Read only; ONE systemctl show a job, as SD Core's.
job.state:
   cmd = SYSTEMCTL : ' show -p NextElapseUSecRealtime -p ActiveState -p ExecMainExitTimestamp -p Result ' : UNIT.PFX : jname : '.timer ' : UNIT.PFX : jname : '.service'
   gosub run.cmd
   nx = '' ; act = '' ; ts = '' ; res = ''
   unit = 1
   for si = 1 to dcount(out, @fm)
      ln = trim(out<si>)
      if ln = '' then
         if si > 1 then unit = 2
      end else
         pn = field(ln, '=', 1)
         pv = trim(ln[len(pn) + 2, len(ln)])
         if unit = 1 and pn = 'NextElapseUSecRealtime' then nx = pv
         if unit = 2 and pn = 'ActiveState' then act = pv
         if unit = 2 and pn = 'ExecMainExitTimestamp' then ts = pv
         if unit = 2 and pn = 'Result' then res = pv
      end
   next si
   if nx = '' or nx = 'n/a' or nx = '0' then nx = 'not scheduled'
   begin case
      case act = 'activating' or act = 'active'
         lr = 'running now'
      case ts = '' or ts = 'n/a'
         lr = 'never'
      case 1
         lr = ts : ' (' : res : ')'
   end case
   return

* ------------------------------------------------------------------------------------------------- the checks

* jname in; ok out.  SD Core's rule (set_job name.ok), word for word.
name.ok:
   ok = @false
   if len(jname) < 1 or len(jname) > 32 then return
   if index('abcdefghijklmnopqrstuvwxyz', jname[1, 1], 1) = 0 then return
   if jname[len(jname), 1] = '-' then return
   if convert('abcdefghijklmnopqrstuvwxyz0123456789-', '', jname) # '' then return
   ok = @true
   return

* sched in (lower case); sched out with hh.mm made hh:mm, cal out (systemd's OnCalendar, SD Core's job_schedule); ok out.
sched.ok:
   ok = @false
   cal = ''
   sched = change(sched, '.', ':')
   if convert('abcdefghijklmnopqrstuvwxyz0123456789: ', '', sched) # '' then return
   ns2 = dcount(sched, ' ')
   s1 = field(sched, ' ', 1)
   s2 = field(sched, ' ', 2)
   s3 = field(sched, ' ', 3)
   begin case
      case s1 = 'every'
         if ns2 = 3 and s3 = 'minutes' and (s2 = '5' or s2 = '10' or s2 = '15' or s2 = '20' or s2 = '30') then
            ok = @true
            cal = '*-*-* *:0/' : s2 : ':00'
         end
      case s1 = 'hourly'
         if ns2 = 1 then
            ok = @true
            cal = '*-*-* *:00:00'
         end
      case s1 = 'daily'
         tm = s2
         gosub time.ok
         if ns2 = 2 and tok then
            ok = @true
            cal = '*-*-* ' : tm : ':00'
         end
      case s1 = 'weekly'
         tm = s3
         gosub time.ok
         dpos = index(' mon tue wed thu fri sat sun ', ' ' : s2 : ' ', 1)
         if ns2 = 3 and tok and dpos > 0 and len(s2) = 3 then
            ok = @true
            cal = upcase(s2[1, 1]) : s2[2, 2] : ' *-*-* ' : tm : ':00'
         end
      case s1 = 'monthly'
         tm = s3
         gosub time.ok
         dd = (if s2 matches '1N' or s2 matches '2N' then s2 else '')
         if ns2 = 3 and tok and dd # '' then
            if dd[1, 1] # '0' and dd >= 1 and dd <= 28 then
               ok = @true
               cal = '*-*-' : dd : ' ' : tm : ':00'
            end
         end
   end case
   return

* tm in; tok out: hh:mm, 00:00 to 23:59
time.ok:
   tok = @false
   if len(tm) # 5 or tm[3, 1] # ':' then return
   hh = tm[1, 2]
   mm = tm[4, 2]
   if not(hh matches '2N') or not(mm matches '2N') then return
   if hh > 23 or mm > 59 then return
   tok = @true
   return

* jcmd in; ok out.  One line of printable ASCII (32 to 126), not empty, at most MAX.CMD characters, and not a job verb itself.
cmd.ok:
   ok = @false
   if jcmd = '' or len(jcmd) > MAX.CMD then return
   for ci = 1 to len(jcmd)
      cc = seq(jcmd[ci, 1])
      if cc < 32 or cc > 126 then return
   next ci
   cw = downcase(field(trim(jcmd), ' ', 1))
   if cw = 'run.job' or cw = 'set.job' then return
   ok = @true
   return

* sw.on out: the register's field 23 is 'yes'.  Read at every use.
switch.on:
   sw.on = @false
   openpath @sdsys : @ds : 'accounts' to sw.f then
      read sw.rec from sw.f, acc.name then
         if upcase(trim(sw.rec<ACC$JOBS>)) = 'YES' then sw.on = @true
      end
      close sw.f
   end
   return

* pw.ok and pw.why out.  The account password, typed now, at a terminal; one try.  Never shown, stored or logged.
ask.password:
   pw.ok = @false
   pw.why = ''
   if ho then
*     From the page's masked field, through the hand-over file (removed already).  The same check, the same refusal.
      pw.match = @false
      if ho.pw # '' then call !CRED_VERIFY(acc.name, ho.pw, pw.match)
      ho.pw = ''
      if pw.match then
         pw.ok = @true
      end else
         crt sysmsg(14940)                                       ;* Wrong password - no job was changed
         pw.why = 'wrong password'
      end
      return
   end
   if kernel(K$TTY, 0) = '' or trim(system(1026)) # '' then
      crt sysmsg(14941)                                          ;* Making or changing a job needs the account password, typed at a terminal
      pw.why = 'no terminal'
      return
   end
   crt sysmsg(11018) : ' ' :                                     ;* Password:
   input pw.text HIDDEN
   crt
   pw.match = @false
   if pw.text # '' then call !CRED_VERIFY(acc.name, pw.text, pw.match)
   pw.text = ''
   if pw.match then
      pw.ok = @true
   end else
      crt sysmsg(14940)                                          ;* Wrong password - no job was changed
      pw.why = 'wrong password'
   end
   return

* ok and why out; jobs.dir, unit.dir, sd.bin out.  The tree and home paths go into shell commands and unit files, so only plain characters are taken.
paths.ok:
   ok = @false
   why = ''
   jobs.dir = @sdsys : @ds : '$jobs'
   sd.bin = @sdsys : @ds : 'bin' : @ds : 'sd-solo'
   home = env('HOME')
   unit.dir = home : '/.config/systemd/user'
   plain = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/._-'
   if @sdsys = '' or convert(plain, '', @sdsys) # '' then
      why = 'the SD directory has a character other than letters, digits and / . _ -'
      return
   end
   if home = '' or home[1, 1] # '/' or convert(plain, '', home) # '' then
      why = 'HOME is not a plain absolute path'
      return
   end
   ok = @true
   return

* ok and why out; jobs.f open.  Makes $jobs (mode 0700) the first time; refuses a link.
open.jobs:
   ok = @false
   why = 'the definitions file'
   cmd = "if [ -L '" : jobs.dir : "' ]; then echo link; exit 1; fi; [ -d '" : jobs.dir : "' ] || mkdir -m 0700 '" : jobs.dir : "'; chmod 0700 '" : jobs.dir : "'"
   gosub run.cmd
   if rc # 0 then return
   openpath jobs.dir to jobs.f else return
   ok = @true
   return

* jname, u.sched, u.cal in; u.ok, u.rc out.  The two unit files, each written whole to a temporary name and renamed; a link in the way is refused.
write.units:
   svc ='# an SD Core for Linux Solo scheduled job, written by set.job; change it with set.job, not by hand'
   svc<-1> = '[Unit]'
   svc<-1> = 'Description=SD Solo scheduled job ' : jname
   svc<-1> = 'After=sd-solo.service'
   svc<-1> = ''
   svc<-1> = '[Service]'
   svc<-1> = 'Type=oneshot'
   svc<-1> = 'UMask=0077'
   svc<-1> = 'WorkingDirectory=%h'
   svc<-1> = 'ExecStart=' : sd.bin : ' "run.job ' : jname : '"'
   tmr = '# an SD Core for Linux Solo scheduled job, written by set.job; change it with set.job, not by hand'
   tmr<-1> = '[Unit]'
   tmr<-1> = 'Description=SD Solo scheduled job ' : jname : ': ' : u.sched
   tmr<-1> = ''
   tmr<-1> = '[Timer]'
   tmr<-1> = 'OnCalendar=' : u.cal
   tmr<-1> = 'Persistent=false'
   tmr<-1> = 'Unit=' : UNIT.PFX : jname : '.service'
   tmr<-1> = ''
   tmr<-1> = '[Install]'
   tmr<-1> = 'WantedBy=timers.target'
   cmd = "mkdir -p '" : unit.dir : "' && cd '" : unit.dir : "' || exit 1"
   for uk = 1 to 2
      if uk = 1 then ufile = UNIT.PFX : jname : '.service' ; utext = svc else ufile = UNIT.PFX : jname : '.timer' ; utext = tmr
      cmd := "; if [ -L '" : ufile : "' ] || { [ -e '" : ufile : "' ] && [ ! -f '" : ufile : "' ]; }; then echo '" : ufile : " is a link or not a plain file'; exit 1; fi"
      cmd := "; printf '%s\n'"
      for ul = 1 to dcount(utext, @fm)
         cmd := " '" : utext<ul> : "'"
      next ul
      cmd := " > '." : ufile : ".new' && chmod 0644 '." : ufile : ".new' && mv -f '." : ufile : ".new' '" : ufile : "' || exit 1"
   next uk
   gosub run.cmd
   if rc # 0 then gosub show.out
   u.ok = (rc = 0)
   u.rc = rc
   return

* jname in; u.ok, u.rc out.  daemon-reload, then the timer enabled and (re)started so a changed OnCalendar is the one in force.
enable.timer:
   cmd = SYSTEMCTL : ' daemon-reload && ' : SYSTEMCTL : ' enable ' : UNIT.PFX : jname : '.timer && ' : SYSTEMCTL : ' restart ' : UNIT.PFX : jname : '.timer'
   gosub run.cmd
   if rc # 0 then gosub show.out
   u.ok = (rc = 0)
   u.rc = rc
   return

* jname in; u.ok, u.rc out.  The timer disabled and stopped, a running service stopped, both files removed, the manager told.  Judged on the files being gone.
remove.units:
   cmd = SYSTEMCTL : ' disable --now ' : UNIT.PFX : jname : '.timer >/dev/null 2>&1; ' : SYSTEMCTL : ' stop ' : UNIT.PFX : jname : '.service >/dev/null 2>&1; '
   cmd := "rm -f -- '" : unit.dir : "/" : UNIT.PFX : jname : ".timer' '" : unit.dir : "/" : UNIT.PFX : jname : ".service'; " : SYSTEMCTL : ' daemon-reload; '
   cmd := "[ ! -e '" : unit.dir : "/" : UNIT.PFX : jname : ".timer' ] && [ ! -e '" : unit.dir : "/" : UNIT.PFX : jname : ".service' ]"
   gosub run.cmd
   if rc # 0 then gosub show.out
   u.ok = (rc = 0)
   u.rc = rc
   return

* jname in; u.any out: either unit file is there (a timer left by a definition that is gone can still be deleted).
units.exist:
   u.any = ospath(unit.dir : '/' : UNIT.PFX : jname : '.timer', OS$EXISTS) or ospath(unit.dir : '/' : UNIT.PFX : jname : '.service', OS$EXISTS)
   return

* ho.ok, ho.action, ho.name, ho.sched, ho.cmd, ho.pw out.  The page's hand-over file, @sdsys/$jobsho/req (a directory of mode 0700, the user's alone):
* five lines - add or change, the name, the schedule, the command, the password.  Read, then REMOVED before anything is decided; a link, a missing file or
* any other first line is refused.  The values are checked by the caller as typed values are.
read.handover:
   ho.ok = @false
   ho.action = '' ; ho.name = '' ; ho.sched = '' ; ho.cmd = '' ; ho.pw = ''
   ho.file = @sdsys : @ds : '$jobsho' : @ds : 'req'
   cmd = "[ ! -L '" : ho.file : "' ] && [ -f '" : ho.file : "' ]"
   gosub run.cmd
   if rc # 0 then
      cmd = "rm -f '" : ho.file : "'"
      gosub run.cmd
      return
   end
   ho.lines = ''
   openseq ho.file readonly to ho.f then
      for hl = 1 to 5
         readseq ln from ho.f then ho.lines<hl> = ln else exit
      next hl
      close ho.f
   end else
      if not(unassigned(ho.f)) then close ho.f
   end
   cmd = "rm -f '" : ho.file : "'"
   gosub run.cmd
   ho.action = downcase(trim(ho.lines<1>))
   if ho.action # 'add' and ho.action # 'change' then return
   ho.name = downcase(trim(ho.lines<2>))
   ho.sched = downcase(trim(ho.lines<3>))
   ho.cmd = trimb(trimf(ho.lines<4>))
   ho.pw = ho.lines<5>
   ho.lines = ''
   ho.ok = @true
   return

* ------------------------------------------------------------------------------------------------- helpers

* sent in; wd (one word a field) and n.words out.  Words are separated by runs of spaces; the sentence itself is not changed, so rest.after can
* give the command exactly as typed.
split.words:
   wd = ''
   n.words = 0
   w = ''
   for ci = 1 to len(sent)
      ch = sent[ci, 1]
      if ch = ' ' then
         if w # '' then
            n.words += 1
            wd<n.words> = w
            w = ''
         end
      end else
         w := ch
      end
   next ci
   if w # '' then
      n.words += 1
      wd<n.words> = w
   end
   return

* sent and skip.n in; rest out: the sentence after its first skip.n words and the spaces after them, as typed (trailing spaces dropped).
rest.after:
   rest = ''
   seen = 0
   inw = @false
   for ci = 1 to len(sent)
      ch = sent[ci, 1]
      if ch = ' ' then
         if inw then
            inw = @false
            seen += 1
         end
      end else
         if not(inw) then
            if seen = skip.n then
               rest = sent[ci, len(sent)]
               exit
            end
            inw = @true
         end
      end
   next ci
   rest = trimb(rest)
   return

* cmd in; out (fields) and rc out.  Built only from words this program checked; the user's own systemd manager is found as the deleter finds it.
run.cmd:
   out = ''
   os.execute 'XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; export XDG_RUNTIME_DIR; ' : cmd : ' 2>&1' capturing out
   rc = os.error()
   out = change(change(out, char(13) : char(10), @fm), char(13), '')
   if out[len(out), 1] = @fm then out = out[1, len(out) - 1]
   return

show.out:
   for i = 1 to dcount(out, @fm)
      if out<i> # '' then crt out<i>
   next i
   return

end

