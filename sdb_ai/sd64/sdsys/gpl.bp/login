$internal
$flags trusted

subroutine login(ok, mode)

$catalogue $LOGIN

$include revstamp.h

$include syscom.h
$include header.h
$include parser.h
$include int$keys.h
$include debug.h

$include err.h
$include keys.h
$include keyin.h
$include keycode.h
* 30 Sep 26 LSOLO 14 (Windows Solo SOLO 18): set.first.password runs the password rule.
deffun pw_complex(pw) calling '!pw_complex'

   ok = @false
   is.phantom = kernel(K$IS.PHANTOM, 0)

* 11 Sep 26 dm - PORT_ADOPTION 13, the port's LOGIN.  The audit trail gets one
*   record at the success exit and one at terminate.connection, not one per
*   gate.  audit.reason is set at each refusal and DEFAULTS TO 'unspecified', so
*   a refusal added later still leaves a line - a vague record is recoverable,
*   a missing one is not.  initial.account gets its empty value here, above
*   every refusal, because three refusals come before the case that sets it and
*   terminate.connection names it.
   audit.reason = 'unspecified'
   initial.account = ''

   * If the terminal type has not yet been set, work out what it is

   if mode = 0 then    ;* Interactive session startup
      s = system(7)
      if s = '' then
            * This user has come in from a command prompt of some sort.
            s = env('TERM')
            if s = '' then s = 'vt100'
      end

* 11 Sep 26 Windows port - A TERM WITH NO SHIPPED TERMINFO ENTRY FALLS BACK
*   (UPSTREAM_FIXES 12; the port's LOGIN).  This call used to be "void", so a
*   TERM that sdsys/terminfo does not have - xterm-256color, screen-256color,
*   tmux-256color: what nearly every graphical terminal and ssh client sets,
*   while only linux, ansi, vt100, xterm and older types ship - loaded NOTHING,
*   and on the first call of a session every capability then reads empty.
*   Everything this program does after here ran without cursor control: the
*   clear screen at sign-on emits nothing, and backspace at a prompt erases
*   nothing.
*
*   IT CANNOT BE LEFT TO THE PARAGRAPH.  The account's login paragraph sets
*   TERM LINUX and that succeeds, but it runs after $LOGIN, so the repair
*   always arrives too late - which is why every check taken at the ':' prompt
*   said the capabilities were fine.
*
*   kernel(K$TERM.TYPE) RETURNS THE TYPE IN FORCE AFTER THE ATTEMPT and leaves
*   it unchanged on failure, so a mismatch is the failure.  downcase first:
*   the type is stored lower case, so an upper-case TERM would not compare
*   equal to itself.  The fallback is linux, the type VOC_TEMPLATE/LOGIN names,
*   so the two defaults agree (the port's is 'windows').
      s = downcase(s)
      if (kernel(K$TERM.TYPE, s) # s) and (s # 'linux') then
         s = 'linux'
         void kernel(K$TERM.TYPE, s)
      end

      * Set terminal depth and width

      s = env('LINES');
      if not(s matches '1N0N') then s = terminfo('lines')
      if s <= 0 then s = DEFAULT.DEPTH
      setpu PU$LENGTH, -1, max(s, MIN.DEPTH)

      s = env('COLUMNS');
      if not(s matches '1N0N') then s = terminfo('cols')
      if s <= 0 then s = DEFAULT.WIDTH
      setpu PU$WIDTH, -1, max(s, MIN.WIDTH)

      * Clear screen except for phantoms and single command execution

      if not(is.phantom) and system(1026) = '' then
         if not(bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET)) then
            display @(-1) :
         end

         if system(7) = 'sdterm' then
            if getpu(PU$WIDTH, -1) < 256 and getpu(PU$LENGTH, -1) < 256 then
               display @(-256, getpu(PU$WIDTH, -1) + 256 * getpu(PU$LENGTH, -1)) :
            end
         end
      end
   end

   if mode = 2 or mode = 3 or mode = 4 then  ;* Just doing a VOC upgrade or install
      if mode = 2 or mode = 4 then           ;* VOC update (4 = UPDATE.ACCOUNTS ALL)
         update.voc.f = voc
         gosub update.voc
         close update.voc.f
      end

* 10 Sep 26 dm - MODE 4 IS "UPDATE.ACCOUNTS ALL", the port's unattended form (its
*   PRE_RELEASE_FIXES 70): the walk runs without the question, says so first
*   (10170) and reports the count (10171).  Anywhere but SDSYS under an
*   administrator it refuses in words (10172) rather than updating one account
*   and staying silent about the rest.
      if mode = 4 and not(@who = 'sdsys' and kernel(K$ADMINISTRATOR,-1)) then
         display sysmsg(10172) ;* Cannot update every account from here
      end

      if @who = 'sdsys' and kernel(K$ADMINISTRATOR,-1) then
         if mode = 4 then
            yn = 'Y'
            display sysmsg(10170) ;* Every registered account will have its VOC updated
         end else
            loop
               display sysmsg(5003) :  ;* Update VOC in all registered accounts (y/<n>)?
               input yn
               yn = upcase(yn)
* 10 Sep 26 dm - Enter takes the default the prompt shows, N (port
*   PRE_RELEASE_FIXES 79).  An empty answer used to re-ask for ever.
               if yn = '' then yn = 'N'
            until yn = 'Y' or yn = 'N'
            repeat
         end

         if yn = 'Y' then
            acc.updated = 0
            voc.paths = @path
            openpath @sdsys:@ds:'accounts' to acc.f then
               select acc.f to 12
               loop
                  readnext acc.name from 12 else exit
                  read acc.rec from acc.f, acc.name then
                     acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)

                     locate acc.path in voc.paths<1> setting s else
                        s = acc.path:@ds:'voc'
                        openpath s to update.voc.f then
                           display sysmsg(5004, s) ;* Updating xx
* 18 Sep 26 dm - TEARDOWN (S.25).  One VOC layer: every account is NEWVOC, so
*   the walk no longer resolves a tier first.
                           gosub update.voc
                           close update.voc.f
                           voc.paths<-1> = acc.path
                           acc.updated += 1
                        end
                     end
                  end
               repeat
               close acc.f
               display sysmsg(10171, acc.updated) ;* xx account(s) had their VOC updated
            end else
               display sysmsg(2200) ;* Cannot open accounts register
            end
         end
      end 

      ok = @true
      return
   end



   if not(bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET)) then
      *display "[ ScarletDME Rev " : SD.REV.STAMP : "   Copyright Ladybridge Systems, " : SD.COPYRIGHT.YEAR : " ]"
* rev 0.9.1 back to single rev track 
      * Modified by Composer AI - 2026/06/10.
      * Close version banner string; unclosed quote caused "Unrecognised statement".
      * display "SD, the Multivalue String Database, version " : SD.REV.STAMP : "(AI modified)
* 09 Sep 26 dm - PRE_RELEASE 17.  The owner's wording, 9 Sep 26.  The port has
*   the same line reading "SD Core for Windows, the Essential Multivalue String
*   Database" (its gpl.bp/LOGIN:432); here the platform is carried by the L in
*   the stamp rather than by the name.  "(AI modified)" is gone with it - the
*   stamp is this project's own number now, so there is nothing left to
*   distinguish it FROM.
* 30 Sep 26 SD Core for Linux Solo (LSOLO 2) - the product's name, as Solo for
*   Windows' banner names its own.
      display "SD Core for Linux Solo, the Essential Multivalue String Database, version " : SD.REV.STAMP
      * --------------------
      display "(c) 2000-2026 by Ladybridge Systems and Other Contributors"
      display
      * following must be left to comply with clause 1 of the gpl licence
      display "This program is free software and is supplied with ABSOLUTELY NO WARRANTY."
      display "You are welcome to modify or redistribute this software subject to certain"
      display "conditions.  For details type CONFIG GPL, for contributors type CONFIG CONTRIB."
      display
   end

   * Open the ACCOUNTS register

   openpath @sdsys:@ds:'accounts' to acc.f else
      display sysmsg(2200) ;* Cannot open accounts register
      audit.reason = 'the accounts register could not be opened'
      goto terminate.connection
   end

* 20240219 mab always run in secure mode, no changes allowed to K$SECURE flag!! * 
*               we also no longer allow telnet connections via the internal
*               telnet server, nor are we supporting serial connections
*               SO we should never be true at the follow test.
*               BUT just to be safe, terminate if we get here as Network/serial connection

  if system(42) or system(1027) then   ;* Network/serial connection
    logmsg sysmsg(5063, 'security test')  ;* Failed login authentication from %1
    audit.reason = 'network or serial connection'
    goto terminate.connection
  end else
     * This user has come in from a command prompt.
     lgn.id = @logname
* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - THE sdusers GATE IS GONE.  There
*   are no SD groups: the one user's tree is in their own home and the file
*   permissions on it are the gate.  @logname is always sduser (kernel.c).  A
*   session with no register record still stops below, at the register read,
*   and every session that is not internal proves the account password (still
*   to be built - LSOLO 6).
* 02 Oct 26 SD Core for Linux Solo (LSOLO 20, S.50) - THE LOGIN HOLD.  While
*   BACKUP.ACCOUNT or RESTORE.ACCOUNT runs, a new session is refused with a
*   message until it finishes (the owner's ruling, 1 Oct 2026, for all four
*   products).  !acc_hold ignores a hold whose holder session has gone.
     call !acc_hold('TEST', hold.info, hold.err)
     if hold.err # '' then
        display sysmsg(hold.err<1,1>, hold.err<1,2>, hold.err<1,3>)
        audit.reason = 'a backup or restore is running'
        goto terminate.connection
     end
  end

* 13 Sep 26 dm - CASE INVERSION IS NO LONGER TURNED ON HERE.  This line set it,
*   the VOC login paragraph's PTERM CASE NOINVERT turned it off again, and so an
*   account without that paragraph typed with every letter flipped (measured on
*   80bd15c).  Nothing between here and the paragraph prompts for input.  C now
*   starts with it off too (linuxio.c); PTERM CASE INVERT still turns it on.

   * Determine account
* 20240330 mab we no longer support forced accounts from $LOGINS
*   forced.account = lgn.rec<LGN$FORCE.ACCOUNT>
   initial.account = ''
   begin case
      
      case kernel(K$FORCED.ACCOUNT,0) # ''   ;* account specified on command line with "sd -Aname"
         initial.account = downcase(kernel(K$FORCED.ACCOUNT,0))

         read acc.rec from acc.f, initial.account else
            display sysmsg(5018, initial.account) ;* Account %1 not in register
            audit.reason = 'not in the register'
            goto terminate.connection
         end


         * 20240330 mab must be privilaged to enter sdsys
         IF (initial.account = "sdsys") and not(kernel(K$ADMINISTRATOR,-1)) then
            display sysmsg(10002) ;* SDSYS Account access is restricted to privileged users
            audit.reason = 'SDSYS is restricted to administrators'
            goto terminate.connection
         end

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - THE ACCOUNT-GROUP TEST IS GONE
*   (there are no groups).  What replaces it: with no group to consult, "sd
*   -Aname" may name only the one account, or SDSYS on the internal door
*   (checked above).  Anything else is refused as not allowed.
         if initial.account # 'sduser' and initial.account # 'sdsys' then
            display sysmsg(10003) ;* User not allowed in requested account
            audit.reason = 'not the one account'
            goto terminate.connection
         end

         acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)

         if not(ospath(acc.path, OS$CD)) then
            display sysmsg(5019, acc.path) ;* Unable to change to directory xx
            audit.reason = 'the account directory could not be entered'
            goto terminate.connection
         end

         

* 20240323 mab if sd command issued with sudo (K$ADMINISTRATOR set by cproc)
*   and no account given wirh -a command, assume sdsys 
      case kernel(K$ADMINISTRATOR,-1)  ;* user id 0, "sudo sd"
         initial.account = "sdsys"

         read acc.rec from acc.f, initial.account else
            display sysmsg(5018, initial.account) ;* Account %1 not in register
            audit.reason = 'not in the register'
            goto terminate.connection
         end

         acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)

         if not(ospath(acc.path, OS$CD)) then
            display sysmsg(5019, acc.path) ;* Unable to change to directory xx
            audit.reason = 'the account directory could not be entered'
            goto terminate.connection
         end

      case 1                              ;* Must be console

      * 20240219 mab sd command from console with no account specified, we default to 
      *              user's account
         initial.account = downcase(@logname)

         read acc.rec from acc.f, initial.account else
            display sysmsg(5018, initial.account) ;* Account %1 not in register
            audit.reason = 'not in the register'
            goto terminate.connection
         end

         acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)

         if not(ospath(acc.path, OS$CD)) then
            display sysmsg(5019, acc.path) ;* Unable to change to directory xx
            audit.reason = 'the account directory could not be entered'
            goto terminate.connection
         end

   end case

* 30 Sep 26 SD Core for Linux Solo (LSOLO 9) - RULING 13: "sd -internal" IS
*   CLOSED ON A DELIVERED SYSTEM AND OPENED, ONE SESSION AT A TIME, BY WHOEVER
*   LEGITIMATELY STARTS ONE.  Ported from SD Core Solo for Windows' LOGIN
*   (RELEASE_1.1 82).  An internal session is admitted only while a marker file
*   $internal exists in the SDSYS directory and is fresh, and internal.gate
*   DELETES it on admission - the consumer closes the window.  Mode 0 only:
*   the update modes (2 to 4) return above and are not asked again.  "sd -i"
*   (the bootstrap) never comes through LOGIN and is already closed on an
*   installed system, because BBPROC refuses when gpl.bp.out/login exists.
   if mode = 0 and kernel(K$INTERNAL,-1) then
      gosub internal.gate
      if not(gate.ok) then goto terminate.connection
   end

* 11 Sep 26 dm - A SUSPENDED ACCOUNT IS NOT ENTERED (PORT_ADOPTION 12; the
*   port's LOGIN of 27 Aug 2026).  After the case and not in each arm, so a
*   fourth arm cannot forget it.  Console and ssh both arrive here - an ssh
*   login the ForceCommand sends to sd (PRE_RELEASE 13) is an ordinary sign-on
*   - and NOTHING IS WITHDRAWN IN LINUX, so the connection is still accepted
*   and the person is refused here rather than by sshd.
*
* 18 Sep 26 dm - TEARDOWN (W.7).  The suspension is its own flag now: field 5,
*   blank means in service, SUSPENDED means suspended.
*
*   UNCONDITIONAL, sudo sd included.  The sudo arm lands in SDSYS only when
*   CPROC granted the administrator flag - a local session running as the
*   sdsys OS user - and SDSYS itself cannot be suspended (MODIFYA, 2202).
   if upcase(trim(acc.rec<ACC$SUSPENDED>)) = 'SUSPENDED' then
      display sysmsg(10107, initial.account) ;* Account %1 is suspended
      audit.reason = 'the account is suspended'
      goto terminate.connection
   end


* 18 Sep 26 dm - TEARDOWN (S.27).  The OS-access grant load is gone: SH and
*   OS.EXECUTE run at the account's own Linux permissions, and SD keeps no
*   second wall.

   * Set @PATH

   account.path = ospath("", OS$CWD)

   initial.account.path = account.path
   if initial.account = '' then
      * Try to work out account name by checking to see if it is in the
      * ACCOUNTS register.

      select acc.f to 12
      loop
         readnext acc.id from 12 else exit
         read acc.rec from acc.f, acc.id then
            acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)
            if account.path = acc.path then
               initial.account = acc.id
               exit
            end
         end
      repeat
      clearselect 12

      if initial.account = '' then
         * Just use final part of pathname
         initial.account = downcase(account.path[index(account.path, @ds, count(account.path, @ds)) + 1, 99999])
      end
   end

   who = initial.account
   close acc.f

   * Set @TTY

   begin case
      case is.phantom          ; tty = 'phantom'
      case system(42) # ''     ; tty = 'telnet'
      case system(1027) # ''   ; tty = 'port'
      case 1                   ; tty = kernel(K$TTY, 0)
   end case

   * Open the VOC file

   openpath "voc" to voc on error
      display 'Error ' : status() : ' opening VOC file. Check access rights.'
      audit.reason = 'the VOC could not be opened'
      goto terminate.connection
   end else
   * 20240219 mab as part of the security changes, do not allow auto creation of account !
   *   gosub create.account
       display sysmsg(5163)    ;* Directory is not a  sd account
       audit.reason = 'not an SD account'
       goto terminate.connection 
   end

   if catalogued('CCALL.INIT') then call ccall.init


   * Open IPC file and delete any items for old versions of this process id

   openpath @sdsys:@ds:'$ipc' to ipc.f then
      recordlocku ipc.f,'M':@userno     ;* Message queue
      delete ipc.f, 'M':@userno

      recordlocku ipc.f,'P':@userno     ;* Phantom register
      delete ipc.f, 'P':@userno

      void fcontrol(ipc.f, FC$NON.TXN, 0) ;* Set non-transactional
   end

   if not(is.phantom) and not(fileinfo(voc, FL$READONLY)) then
      read voc.rec from voc, "$release" then     ;* 13 Sep 26 - plan M3, the $ records
* 07 Oct 26 SD Core for Linux Solo (LSOLO 43, the full product's PAL-12; Windows RELEASE_1.1 39
*   and Windows Solo's, owner 16 Sep 2026, "proceed silently").  THE OLD PER-LOGIN
*   RELEASE-MISMATCH PROMPT (5025/5026/5027, Field 2) IS REMOVED.  It ran an unguarded
*   `input` on the mode-0 path, so a session with no keyboard behind it (the
*   installer's hidden upgrade sessions, a script driving sd) blocked on it.  It is
*   redundant: solo-stage.sh drives UPDATE.ACCOUNTS ALL (mode 4) on an upgrade and on a
*   reload of kept data (LSOLO 13, LSOLO 39 - LSOLO 41 said the installer never did,
*   having read installsdsolo.sh and not the stage script it runs), so a mismatch at an
*   ordinary login simply PROCEEDS and the VOC is refreshed by the next UPDATE.ACCOUNTS.
*   Field 2 (release level) is no longer read; Field 3 still is.  5025/5026/5027 stay in
*   the messages, as on the Windows port (message number parity).
         * ----- Field 3 - Command processing modes
         s = voc.rec<3>
         cursor.at.end = (index(s, 'E', 1) # 0)
         command.overlay = (index(s, 'O', 1) # 0)
         show.stack = (index(s, 'S', 1) # 0)
         clear.on.data = not(index(s, 'X', 1)) and not(cursor.at.end)
      end else
         display sysmsg(5028) ;* $release VOC record not found
         audit.reason = 'the $release VOC record is missing'
         goto terminate.connection
      end

      * Cross-check revisions

      if compare(system(1012), SD.REV.STAMP) then
         display sysmsg(5029) ;* Revision level cross-check error
         audit.reason = 'revision level cross-check error'
         if not(kernel(K$INTERNAL,-1)) then goto terminate.connection
      end

      * Look for a saved command stack

      read voc.rec from voc,"$command.stack" then
         if upcase(voc.rec[1,1]) = "X" THEN

           openpath initial.account.path:@ds:'stacks' to stk.f then
              read command.stack from stk.f, @logname else null
              close stk.f
           end

         end
      end
   end

* 20 Sep 26 dm - THE BATCH GATE, PARITY WITH THE WINDOWS PORT (owner's
*   ruling, 20 Sep 2026: a behavior prevented on one port must be prevented
*   on both, the mechanism free to differ with the OS).  A session invoked as
*   "sd '<command>'" - system(1026), the same single-command mechanism
*   CPROC's own single-command branch reads back as at.command (:762) - is
*   admitted by an ELEVATED session as before, or by the account's own list
*   in SDSYS batch.jobs, and refused otherwise.  See batch.permitted.
*
*   LINUX NEVER HAD EITHER HALF.  CPROC has run any command line
*   unconditionally since it was written: the group-membership test above
*   proves WHO is running it, never WHAT it may run unattended.  Windows
*   built batch.jobs 22 Aug 2026 (its PROJECT_STATUS.md 7 step 9) because
*   sd.exe used to refuse EVERY unelevated command line outright, which
*   refused the legitimate scheduled job this exists for along with
*   everything else - the same distinction still applies here: an
*   interactive session has a human present to use judgement, a bare command
*   line does not, so it gets a pre-vetted list instead, regardless of whose
*   Linux identity is running it.
* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - THE BATCH GATE IS GONE, as in SD
*   Core Solo for Windows (SOLO 4).  It limited what an unattended "sd <cmd>"
*   could run to a list in SDSYS batch.jobs, because the multi-user product runs
*   other people's commands.  In Solo "sd <command>" is the one user running
*   their own command, and the administrator verbs are gated by ADMIN where they
*   run (LSOLO 6), not here.  The batch.permitted subroutine that followed this
*   is deleted with it.

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - RULING 21: EVERY SESSION PROVES
*   THE ACCOUNT PASSWORD - at the keyboard, over ssh and for a one-shot "sd
*   <command>" alike.  Three exemptions, each for its own reason: mode 1 is the
*   API (SCRAM, apisrvr), a phantom inherits its parent's login, and the
*   internal door is the installer's.  require.password below has the rules,
*   including the one that a one-shot command must never stop at a prompt.
   if mode = 0 and not(is.phantom) and not(kernel(K$INTERNAL,-1)) then
      one.shot = (trim(system(1026)) # '')
      gosub require.password
      if not(pw.ok) then
         audit.reason = pw.why
         goto terminate.connection
      end
   end

* 11 Sep 26 dm - THE SUCCESS RECORD, mode 0 only: the update modes reach here
*   too and are not sign-ons.
* 07 Oct 26 SD Core for Linux Solo (LSOLO 43, the full product's PAL-16) - a sign-on that
*   was a single command line ("sd-solo 'command'") records the command, as Windows
*   Solo's does, so the trail says WHAT ran unattended and not only who.  An
*   interactive sign-on is unchanged.
   if mode = 0 then
      one.command = ''
      if not(is.phantom) and not(kernel(K$INTERNAL,-1)) then one.command = trim(system(1026))
      if one.command = '' then
         void kernel(K$AUDIT, 'LOGIN account=' : initial.account)
      end else
         void kernel(K$AUDIT, 'LOGIN account=' : initial.account : ' command=' : one.command)
      end
   end
   ok = @true
   return

terminate.connection:
   void kernel(K$AUDIT, 'LOGIN REFUSED account=' : initial.account : ' reason=' : audit.reason)
   display sysmsg(5024) ;* Connection terminated
   sleep 2
abort.login:
   return to abort.login

*
* ======================================================================
* INTERNAL.GATE  -  may this internal session start?  Sets gate.ok.
* 30 Sep 26 SD Core for Linux Solo (LSOLO 9), ruling 13; SD Core Solo for
* Windows' routine of the same name, RELEASE_1.1 82.
*
* THE RULE.  A marker file named $internal must exist in the SDSYS directory and
* be at most gate.expiry seconds old.  It is DELETED here, before the decision,
* so no path leaves the window open.  Whoever legitimately starts an internal
* session - the installer's steps, the bootstrap, a verifier - writes ONE marker
* immediately before it (gplbld/solo-stage.sh and installsdsolo.sh do).  A marker
* written and never used authorises exactly one later session, for ten minutes.
*
* WHAT IT IS NOT.  A speed bump, not a boundary: the tree belongs to the user, who
* can write the file by hand (and can edit the BASIC).  That is the owner's own
* standard - "the developer mode switch is not a published feature, it has to be
* discovered by looking at the source code, which is fine in an open source
* product" - and this comment says so rather than pretending.
*
* AGE is measured on the filesystem's own clock: a scratch file is created and ITS
* mtime read, because BASIC cannot ask for the current time in the same base as a
* file's mtime.  OPENSEQ does not create a file; CREATE does (the Windows first
* version assumed otherwise and admitted an 11-minute-old marker for ever).  If the
* age cannot be measured it stays -1 and the marker is treated as fresh: expiry is
* the weaker half, consumption is what closes the window.
*
* THE REFUSAL SAYS NOTHING ABOUT WHY: it leaves through terminate.connection, so
* the operator sees "Connection terminated" and the audit trail carries the
* reason.  EVERY USE IS AUDITED, admitted or refused, with the writer named on the
* marker's first line (capped).  An admitted session ANNOUNCES itself (11040).

internal.gate:
   gate.ok = @false
   gate.marker = @sdsys : @ds : '$internal'
   gate.expiry = 600           ;* seconds
   gate.writer = ''
   gate.age = -1

   if ospath(gate.marker, OS$EXISTS) then
      gate.mtime = ospath(gate.marker, OS$DTM)

      openseq gate.marker to gate.mf then
         readseq gate.writer from gate.mf else gate.writer = ''
         closeseq gate.mf
      end else gate.writer = ''
      gate.writer = trim(gate.writer[1, 80])

      gate.stamp = @sdsys : @ds : '$internal.now'
      void ospath(gate.stamp, OS$DELETE)
      openseq gate.stamp to gate.sf else
         create gate.sf else gate.sf = ''
      end
      if ospath(gate.stamp, OS$EXISTS) then
         closeseq gate.sf
         gate.now = ospath(gate.stamp, OS$DTM)
         if gate.now > 0 and gate.mtime > 0 then gate.age = gate.now - gate.mtime
      end
      void ospath(gate.stamp, OS$DELETE)

*     THE CONSUMER CLOSES THE WINDOW: delete before deciding.
      void ospath(gate.marker, OS$DELETE)
      if ospath(gate.marker, OS$EXISTS) then
         audit.reason = 'the internal marker could not be consumed'
      end else
         if gate.age > gate.expiry then
            audit.reason = 'the internal marker had expired'
         end else
            gate.ok = @true
         end
      end
   end else
      audit.reason = 'no internal marker'
   end

   audit.account = initial.account
   if gate.ok then
      void kernel(K$AUDIT, 'INTERNAL SESSION ADMITTED account=' : initial.account : ' writer=' : gate.writer : ' age=' : gate.age)
      display sysmsg(11040, gate.writer) ;* Internal session admitted (opened by %1)
   end
   return

*
* ======================================================================
* REQUIRE.PASSWORD  -  the session proves the account password.  Sets pw.ok,
* and pw.why when it is false.  29 Sep 26 SD Core for Linux Solo, ruling 21;
* SD Core Solo for Windows' routine of the same name, less its DPAPI file (here
* a private file in clear - !SOLO_STORE_PW) and less the managed tree's
* first-password prompt, which comes with the installer's control file
* (LSOLO 9).
*
* WHICH PASSWORDS.  The account's own ($cred, keyed by the account name) or,
* in managed mode, the global one ($GLOBAL) - the pair the API takes (ruling
* 19).  The global password unlocks the administrator commands for the
* session, as ADMIN does with it.
*
* WHERE IT COMES FROM, AND THE RULE THAT DECIDES IT:
*   an interactive "sd" (no command)   asked for; three tries on a terminal,
*                                      one on a pipe (a script's first line)
*   a one-shot "sd <command>"          NEVER A PROMPT.  The kept password
*                                      ($STORED) is tried first; then the
*                                      input when that is not a terminal;
*                                      refused at once when it is.
*
* NO RECORD TO CHECK AGAINST IS SAID PLAINLY, not reported as a wrong password:
* the account has no password only if an install went wrong, and the way out
* is to install again.  !CRED_VERIFY fails closed on it anyway.  The password
* is never displayed, stored or logged; the outcome is audited.

require.password:
   pw.ok = @false
   pw.why = ''
   pw.via = ''
   pw.interactive = not(one.shot)
   pw.on.tty = (kernel(K$TTY,0) # '')

   pw.has.acct = @false
   pw.has.global = @false
   openpath @sdsys:@ds:'$cred' to pw.cred.f then
      read pw.rec from pw.cred.f, initial.account then pw.has.acct = @true
*     Record ids in $cred are LOWER CASE ($global, $stored): a case-sensitive
*     filesystem, and !CRED_SET stores them that way (see admin).
      read pw.rec from pw.cred.f, '$global' then pw.has.global = @true
      close pw.cred.f
   end
   pw.rec = ''
   if not(pw.has.acct or pw.has.global) then
      display sysmsg(11020) ;* This account has no password - install SD Core for Linux Solo again...
      pw.why = 'the account has no password'
      return
   end

*  30 Sep 26 - LSOLO 14 (Windows Solo SOLO 18, owner 27 Sep 2026): A MANAGED TREE
*  INSTALLED FROM A CONTROL FILE HAS NO ACCOUNT PASSWORD UNTIL ITS FIRST LOGIN,
*  and it is set AT THE CONSOLE ONLY: an interactive session, on a terminal, not
*  over ssh.  Managed only ($global present), as the control file is; a
*  tree with no global password and without its record still gets 11020 above.  Anywhere else the
*  session is told so, and the prompt below then accepts only the global
*  password (the master's, ruling 19), as it always has.
   if not(pw.has.acct) and pw.has.global then
      if pw.interactive and pw.on.tty and env('SSH_CONNECTION') = '' then
*        Assigned here too: BCOMP reads in order, and set.first.password is
*        further down (the ERRGEN trap, "is not assigned a value").
         pf.ok = @false
         gosub set.first.password
         if pf.ok then
            pw.via = 'first'
            void kernel(K$AUDIT, 'LOGIN FIRST PASSWORD SET account=' : initial.account)
            pw.ok = @true
         end else
            pw.why = 'no first password was set'
            void kernel(K$AUDIT, 'LOGIN REFUSED account=' : initial.account : ' - no first password was set')
         end
         return
      end
      display sysmsg(11026) ;* This account has no password yet. Set it at this computer's keyboard first...
   end

*  A ONE-SHOT TRIES THE KEPT PASSWORD FIRST.  $STORED in $cred is the account
*  password (!SOLO_STORE_PW).  It counts only for THIS account and only if it
*  still verifies; anything else - no record, a stale copy - falls through to
*  the input exactly as before, silently, because a scheduled job with its
*  password on the input must still work.  It proves the account password,
*  never the global one, so it never unlocks ADMIN.
   if not(pw.interactive) then
      openpath @sdsys:@ds:'$cred' to pw.cred.f then
         read pw.rec from pw.cred.f, '$stored' else pw.rec = ''
         close pw.cred.f
      end
      if pw.rec<1> = upcase(initial.account) and pw.rec<2> # '' then
         pw.match = @false
         call !CRED_VERIFY(initial.account, pw.rec<2>, pw.match)
         if pw.match then pw.via = 'stored'
      end
      pw.rec = ''
      if pw.via # '' then
         void kernel(K$AUDIT, 'LOGIN PASSWORD account=' : initial.account : ' via=stored')
         pw.ok = @true
         return
      end
   end

   if not(pw.interactive) and pw.on.tty then
      display sysmsg(11017) ;* A command given on the sd command line needs the password on its input
      pw.why = 'one-shot command with no password source'
      return
   end

   if pw.interactive and pw.on.tty then pw.tries = 3 else pw.tries = 1
   for pw.t = 1 to pw.tries
      if pw.on.tty then display sysmsg(11018) : ' ' :  ;* Password:
      input pw.text HIDDEN
      if pw.on.tty then display
      if pw.text # '' then
         pw.match = @false
         call !CRED_VERIFY(initial.account, pw.text, pw.match)
         if pw.match then
            pw.via = 'account'
         end else
            call !CRED_VERIFY('$GLOBAL', pw.text, pw.match)
            if pw.match then pw.via = 'global'
         end
      end
      pw.text = ''
      if pw.via # '' then exit
      display sysmsg(11019) ;* Wrong password
   next pw.t

   if pw.via = '' then
      pw.why = 'wrong or missing account password'
      void kernel(K$AUDIT, 'LOGIN REFUSED account=' : initial.account : ' - wrong or missing password')
      return
   end

*  A $GLOBAL sign-in unlocks the administrator commands, as ADMIN does with it.
*  30 Sep 26 LSOLO 12 - ruling 33: it is ALSO marked as one (K$GLOBAL.SESSION),
*  after the administrator flag that key requires.  Only such a session may
*  change the global catalogue.
   if pw.via = 'global' then
      void kernel(K$ADMINISTRATOR, 1)
      void kernel(K$GLOBAL.SESSION, 1)
   end
   void kernel(K$AUDIT, 'LOGIN PASSWORD account=' : initial.account : ' via=' : pw.via)
   pw.ok = @true
   return

*
* ======================================================================
* SET.FIRST.PASSWORD  -  LSOLO 14 (Windows Solo SOLO 18): the account's first
* password, at the console.
*
* Sets pf.ok.  Three tries, the password rule, the repeat, with Solo's two
* stores: !CRED_SET - which takes $global's salt for a new account record, so
* the master's password still logs in under this name (ruling 19) - and $stored
* for one-shot commands (!SOLO_STORE_PW), as SET.PASSWORD does.  An empty answer
* gives up.  Neither password is displayed, stored in clear or logged.

set.first.password:
   pf.ok = @false
   pf.max = 3
   pf.pw1 = ''
   pf.pw2 = ''
   display sysmsg(11025) ;* This account has no password yet. Choose one now...
   display
   for pf.try = 1 to pf.max
      display sysmsg(11009) : ' ' :  ;* New password:
      input pf.pw1 HIDDEN
      display
      if pf.pw1 = '' then exit
      if not(pw_complex(pf.pw1)) then
         display sysmsg(10920)  ;* A password needs at least 8 characters...
         display sysmsg(10921, pf.try, pf.max) ;* That was attempt %1 of %2
         continue
      end
*     Ruling 19: equal to the global password, the master's logins would land
*     in an ordinary session.
      pf.same = @false
      call !CRED_VERIFY('$GLOBAL', pf.pw1, pf.same)
      if pf.same then
         display sysmsg(11027) ;* Use a password different from the global password.
         display sysmsg(10921, pf.try, pf.max) ;* That was attempt %1 of %2
         continue
      end
      display sysmsg(11010) : ' ' :  ;* Confirm the new password:
      input pf.pw2 HIDDEN
      display
      if pf.pw1 # pf.pw2 then
         pf.pw2 = ''
         display sysmsg(11011) ;* The passwords do not match
         display sysmsg(10921, pf.try, pf.max) ;* That was attempt %1 of %2
         continue
      end
      pf.pw2 = ''
      pf.set = @false
      call !CRED_SET(upcase(initial.account), pf.pw1, pf.set)
      if not(pf.set) then
         display sysmsg(11016, status()) ;* The password could not be stored (status %1)
         exit
      end
      pf.kept = @false
      call !SOLO_STORE_PW(upcase(initial.account), pf.pw1, pf.kept)
      if not(pf.kept) then display sysmsg(11022, status()) ;* ...could not be kept for commands given on the sd command line
      display sysmsg(11036, initial.account) ;* Password set for account %1
      pf.ok = @true
      exit
   next pf.try
   pf.pw1 = ''
   pf.pw2 = ''
   if not(pf.ok) then display sysmsg(11037) ;* No password was set, and one is required...
   return

*
* ======================================================================
* UPDATE.VOC  -  Copy NEWVOC to VOC

update.voc:
   yn = ''

* 11 Sep 26 Windows port - [locked] RECORDS (port PRE_RELEASE_FIXES 70, the
*   owner's design of 2 Sep 2026).  A site marks a VOC record it has customised
*   by putting [locked] in field 1 after the type code, and an update leaves it
*   alone - EXCEPT a verb (see the test below).  Both tallies are reported by
*   name after the loop: a silent skip turns "I protected my customisation"
*   into "I never received the fix" with nothing to connect the two.  Kept
*   apart on purpose: they are opposite outcomes.
   locked.count = 0
   locked.ids = ''
   overridden.count = 0
   overridden.ids = ''

   openpath @sdsys:@ds:"newvoc" to sdsys.file else
      display sysmsg(2210) ;* Cannot open SDSYS NEWVOC
      goto abort.login
   end

* 18 Sep 26 dm - TEARDOWN (S.25).  One VOC layer: NEWVOC as shipped, the
*   PROGRAMMER set, is what every account now gets.  The STANDARD omit filter
*   (S.3) and the administrator add layer are gone; the loop below copies all
*   of NEWVOC, nothing filtered out and nothing added from VOC_TEMPLATE.
*   SDSYS's own VOC holds the administrator verbs because the install builds
*   it from the whole of VOC_TEMPLATE (bbproc), not because this routine adds
*   them.
   select sdsys.file to 11
   loop
      readnext id from 11 else exit

      read rec from sdsys.file,id then
         new.type = upcase(rec[1,1])
         if new.type = 'P' then new.type = upcase(rec[1,2])

* 10 Sep 26 dm - old.rec IS CLEARED FIRST.  A failed READU leaves its variable
*   untouched, so for an id this VOC lacks, old.rec still held the PREVIOUS id's
*   record and the compare() below could decide not to write.  NEWVOC has
*   byte-identical pairs (CATALOG/CATALOGUE, CD/COMPILE.DICT), so an account
*   holding one and lacking the other never got it.  The port's 17 Aug 2026
*   fix; upstream has the same defect.
         old.rec = ''
         readu old.rec from update.voc.f, id then
* 11 Sep 26 Windows port - THE LOCK IS TESTED ON old.rec, NOT rec: rec is what
*   NEWVOC ships and can never carry the marker; old.rec is this account's own
*   record, the only thing that knows whether a person changed it.  AFTER THE
*   TYPE CODE: the first character (two for a P) IS the type, so INDEX, which
*   finds it anywhere, is right.  UPCASE BOTH SIDES - a lock that fails open
*   because somebody typed [LOCKED] would be worse than no lock.  RELEASE
*   BEFORE CONTINUE, as the declined type change below does.
*
*   A VERB DOES NOT HONOUR THE LOCK - the owner's ruling for the port, 2 Sep
*   2026: users should not be modifying verbs, and one who needs different
*   behaviour adds a verb under a name SD does not ship, which this loop never
*   visits.  A verb is what SD RUNS: a held-back V|IN record's field 3 is a
*   NUMBER, so a renumbering would dispatch it to a different function
*   silently.  Overruled locks are reported separately (10166).
            if index(upcase(old.rec<1>), '[LOCKED]', 1) then
               if new.type = 'V' then
                  overridden.count += 1
                  overridden.ids<-1> = id
               end else
                  locked.count += 1
                  locked.ids<-1> = id
                  release update.voc.f, id
                  continue
               end
            end

            old.type = upcase(old.rec[1,1])
            if old.type = 'P' then old.type = upcase(old.rec[1,2])

            * Special case to avoid prompt for 2.4-15 change to MD item
* 11 Sep 26 Windows port - upcase(id), so this survives section M's rename of
*   the record to 'md' (port 5.12 (b)).  Identical today: every id is upper.

            if upcase(id) = 'MD' and (old.type = 'Q' or old.type = 'F') then
               goto accept.without.query
            end

            if new.type # old.type then
               if yn # 'A' then
                  display
                  display sysmsg(5048, id, old.type) ;* Existing VOC record %1 is of type %2
                  display sysmsg(5049, new.type) :  ;* Update VOC record is of type %1. Replace record(Y/N)?
                  loop
                     input yn
                     yn = upcase(yn)
* 10 Sep 26 dm - ENTER TAKES N, which keeps the record this account already has
*   (port PRE_RELEASE_FIXES 79).  A is "yes to this and every one after it", so
*   it is further from the conservative answer than Y, not nearer.
                     if yn = '' then yn = 'N'
                  until yn = 'Y' or yn = 'N' or yn = 'A'
                    display sysmsg(5058) : ;* Replace record (Yes/No/All)?
                  repeat
                  if yn = 'N' then
                     release update.voc.f, id
                     continue
                  end
               end
            end
         end

accept.without.query:
* 10 Sep 26 dm - THE RECORD IS WRITTEN WHOLE, the port's PRE_RELEASE_FIXES 136
*   (2 Sep 2026).  Two lines here reduced field 1 - the description whose first
*   character is the type code - and a K record's field 3 to their type
*   letters.  CREATEA no longer does, and this runs on every update, so keeping
*   them would strip the descriptions CREATEA writes the first time an account
*   is updated.  CPROC reads only voc.rec[1,1] and [1,2]; new.type above is
*   still derived that way.

         if compare(old.rec, rec) then
            write rec to update.voc.f, id
            display '.' :
         end else
            release update.voc.f, id
         end
      end
   repeat
   display

* 18 Sep 26 dm - TEARDOWN (S.25).  The administrator add layer is gone with
*   the tier model.  Every account's VOC is NEWVOC; the administrator verbs
*   exist only in SDSYS's own VOC, which the install builds from the whole of
*   VOC_TEMPLATE (bbproc).  This routine neither adds nor removes them.

* 11 Sep 26 Windows port - NAME THEM, do not just count them: "3 records were
*   locked" leaves the reader no way to find out which fix they have not
*   received.  Field marks become spaces - one line of prose, not a list.
   if locked.count then
      display sysmsg(10165, locked.count, convert(@fm, ' ', locked.ids))
   end

*  And the overruled ones, separately, though nothing was withheld: the site
*  asked for something it did not get, and is told where to put the behaviour.
   if overridden.count then
      display sysmsg(10166, overridden.count, convert(@fm, ' ', overridden.ids))
   end

* 03 Oct 26 SD Core for Linux Solo (LSOLO 30) - RETIRED VERBS.  The loop above only adds
*   and replaces, so a verb a release stops shipping would stay in every account that
*   already has it.  LOGTO is the first (removed in LS1.1-3); to retire another, add
*   its id here and delete its files from the sdsys tree and from solo-stage.sh's
*   retired list.  ONLY THE SHIPPED RECORD IS DELETED - a verb whose type, kind and
*   number are exactly what this release shipped.  A person's own paragraph or program
*   that happens to be called LOGTO is theirs and is left alone.  Both spellings are
*   tried because a VOC may hold either.
   retired.ids = 'LOGTO' : @fm : 'logto'
   for ri = 1 to dcount(retired.ids, @fm)
      rid = retired.ids<ri>
      old.rec = ''
      readu old.rec from update.voc.f, rid then
         if old.rec<1>[1,1] = 'V' and old.rec<2> = 'IN' and old.rec<3> = '17' then
            delete update.voc.f, rid
         end else
            release update.voc.f, rid
         end
      end else
         release update.voc.f, rid
      end
   next ri

   close sdsys.file

   return

end

* END-CODE
