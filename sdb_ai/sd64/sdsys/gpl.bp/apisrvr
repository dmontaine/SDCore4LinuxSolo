* ======================================================================
* SrvrQuit  -  Disconnect server

vb.quit:
done = @true
return

* ======================================================================
* SrvrGetError  -  Return extended error text

vb.geterror:
response = error.msg
return

* ======================================================================
* SrvrAccount  -  Logto named account
* In:  account name or path

vb.account:
* Run the ON.LOGTO paragraph, if it exists

readv i from @voc,'ON.LOGTO',0 on error null
then execute 'ON.LOGTO' trapping aborts capturing response

* 14 Sep 26 dm - LOWER CASE, GOING PAST THE PORT, which upcases (plan M: no
*   account name exists in two casings).  WHO is set from this at the end, so
*   an upcase here showed ZZREL1 over the API where CPROC's LOGTO shows zzrel1.
*   A PATH is left as typed - a Linux path is case-sensitive, and upcasing one
*   could only ever have missed it.
new.account = cmnd
if index(new.account, @ds, 1) = 0 then new.account = downcase(new.account)

old.account.path = account.path

if len(new.account) < 1 or len(new.account) > MAX.ACCOUNT.NAME.LEN then
   server.error = SV$ERROR
   error.msg = sysmsg(5037) ;* Invalid account name
   goto revert.to.old.account
end

account.path = new.account
acc.suspended = @false
if index(new.account, @ds, 1) = 0 then
   openpath @sdsys:@ds:'accounts' to acc.f then
      read acc.rec from acc.f, downcase(new.account) then
         account.path = parse.pathname.tokens(acc.rec<ACC$PATH>)
         acc.suspended = (upcase(trim(acc.rec<ACC$SUSPENDED>)) = 'SUSPENDED')
      end
      close acc.f
   end
end

* 11 Sep 26 dm - A SUSPENDED ACCOUNT IS NOT ENTERED (PORT_ADOPTION 12; the
*   port's APISRVR of 27 Aug 2026).  The third door, after LOGIN and CPROC's
*   LOGTO; an API caller reaches an account through neither.
*
*   IT REUSES 10003, AND THAT IS THE RULE HERE.  Every refusal in this routine
*   gives the same text, so a caller cannot tell "no such account" from "not a
*   member" from "suspended", and the API does not enumerate the register for
*   anyone probing it.  No administrator exemption: an API session carries none.
if acc.suspended then
    server.error = SV$ERROR
    error.msg = sysmsg(10003) ;* User not allowed in requested account
    abort.message = error.msg
    goto revert.to.old.account
end

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - THE GROUP TEST IS GONE, AND
*   SOLO'S RULE REPLACES IT (SD Core Solo for Windows' "branch 4").  There are
*   no SD groups and no SDSYS exemption: the one enterable account is the one
*   the session holds - the name the SCRAM login proved, sduser - and SDSYS is
*   never a target (owner's ruling 11), whatever the transport.  The name is
*   read from the session (K$USERNAME), not from a client-supplied value.
acc.who = downcase(kernel(K$USERNAME, 0))
acc.member = (downcase(new.account) # 'sdsys') and (downcase(new.account) = acc.who)
if not(acc.member) then
   void kernel(K$AUDIT, 'ACCOUNT REFUSED not.own.account user=' : acc.who : ' account=' : new.account)
   server.error = SV$ERROR
   error.msg = sysmsg(10003) ;* User not allowed in requested account
   abort.message = error.msg
   goto revert.to.old.account
end

* 29 Sep 26 SD Core for Linux Solo - the tier-ordering gate was already gone
*   with the tier model (S.25); the own-account test above is the whole of the
*   wall now.

if not(ospath(account.path, OS$CD)) then
   server.error = SV$ERROR
   error.msg = sysmsg(5019, account.path) ;* Unable to change to directory %1
   goto revert.to.old.account
end

openpath "voc" to new.voc else
   server.error = SV$ERROR
   error.msg = sysmsg(5163) ;* Directory is not a SD account
   goto revert.to.old.account
end

i = ospath("", os$flush.cache)

account.path = ospath("", os$cwd)     ;* Ensure @PATH is absolute path
initial.account.path = account.path   ;* Make WHO show only one element
who = new.account

voc = new.voc

* 0452 Set up the private catalogue pathname

private.catalogue = 'cat'
read voc.rec from voc, "$PRIVATE.CATALOGUE" then
   if upcase(voc.rec[1,1]) = 'X' then private.catalogue = voc.rec<2>
end

i = kernel(K$PRIVATE.CATALOGUE, private.catalogue)

* Run the LOGIN paragraph, if it exists

* 18 Aug 26 Windows port - AS TYPED, THEN LOWER, port PROJECT_STATUS 5.12 (b).
*   @voc is a DYNAMIC file, so this is an exact byte match; without the second
*   attempt an API session would silently stop running the LOGIN paragraph the
*   moment the VOC id moves.  Blocked THEN/ELSE deliberately - see 5.12 trap 3.
readv i from @voc, 'LOGIN', 0 on error null
then
   execute 'LOGIN' trapping aborts capturing response
end else
   readv i from @voc, 'login', 0 on error null
   then
      execute 'login' trapping aborts capturing response
   end
end

return

revert.to.old.account:
if not(ospath(old.account.path, OS$CD)) then
   server.error = SV$ERROR
   error.msg = sysmsg(5162) ;* Fatal error : Cannot return to previous account
   return to abort.vbsrvr
end

return

* ======================================================================
* Open file
* In:  fname
* Out: fileno (short integer)

vb.open:
if kernel(K$SDNET, -1)  or config("SDCLIENT") # 0 then
   abort.message = sysmsg(5262) ;* File access is disabled
   server.error = SV$ON.ERROR
   return
end

* Locate a spare file table entry

n = inmat(files)

for i = 1 to n
   if not(fileinfo(files(i), FL$OPEN)) then goto vb.open.continue
next i

* Extend file table

dim files(n + 50)
i = n + 1

vb.open.continue:
* Open file to file table entry i

open cmnd to files(i)
on error server.error = SV$ON.ERROR
then
   if bitand(fileinfo(files(i), FL$FLAGS), FL$FLAGS.TRUSTED) then
      server.error = SV$ELSE
      end else
         response = iconv(i, 'ISL')
      end
   end
   else server.error = SV$ELSE

      return

      * ======================================================================
      * Close file
      * In:  fileno (short integer)
      * Out:

vb.close:
      fno = oconv(cmnd[1,2], 'ISL')
      gosub check.file
      if err then return

      close files(fno)   ;* 0346

      return

      * ======================================================================
      * Read record
      * In:  fileno (short integer)
      *      id
      * Out: record

vb.read:
      fno = oconv(cmnd[1,2], 'ISL')
      gosub check.file
      if err then return

      id = cmnd[3,99]
      read rec from files(fno), id
      on error
      server.error = SV$ON.ERROR
   end then
      response = rec
   end else
      server.error = SV$ELSE
      end

      return

      * ======================================================================
      * Read record with shared lock
      * In:  fileno (short integer)
      *      id
      * Out: record

vb.readl:
      fno = oconv(cmnd[1,2], 'ISL')
      gosub check.file
      if err then return

      id = cmnd[3,99]
      readl rec from files(fno), id
      on error
      server.error = SV$ON.ERROR
   end locked
      server.error = SV$LOCKED
      end then
         response = rec
      end else
         server.error = SV$ELSE
         end

         return

         * ======================================================================
         * Read record with shared lock, waiting if locked
         * In:  fileno (short integer)
         *      id
         * Out: record

vb.readlw:
         fno = oconv(cmnd[1,2], 'ISL')
         gosub check.file
         if err then return

         id = cmnd[3,99]
         readl rec from files(fno), id
         on error
         server.error = SV$ON.ERROR
      end then
         response = rec
      end else
         server.error = SV$ELSE
         end

         return

         * ======================================================================
         * Read record with exclusive lock
         * In:  fileno (short integer)
         *      id
         * Out: record

vb.readu:
         fno = oconv(cmnd[1,2], 'ISL')
         gosub check.file
         if err then return

         id = cmnd[3,99]
         readu rec from files(fno), id
         on error
         server.error = SV$ON.ERROR
      end locked
         server.error = SV$LOCKED
         end then
            response = rec
         end else
            server.error = SV$ELSE
            end

            return

            * ======================================================================
            * Read record with exclusive lock, waiting if locked
            * In:  fileno (short integer)
            *      id
            * Out: record

vb.readuw:
            fno = oconv(cmnd[1,2], 'ISL')
            gosub check.file
            if err then return

            id = cmnd[3,99]
            readu rec from files(fno), id
            on error
            server.error = SV$ON.ERROR
         end then
            response = rec
         end else
            server.error = SV$ELSE
            end

            return

            * ======================================================================
            * Select file
            * In:  file no  (short int)
            *      list no  (short int)

vb.select:
            fno = oconv(cmnd[1,2], 'ISL')
            gosub check.file
            if err then return

            listno = oconv(cmnd[3,2], 'ISL')
            gosub check.list
            if err then return

            select files(fno) to listno

            return

            * ======================================================================
            * Read next entry from select list
            * In:  listno (short integer)
            * Out: id

vb.readnext:
            listno = oconv(cmnd[1,2], 'ISL')
            gosub check.list
            if err then return

            readnext response from listno else server.error = SV$ELSE

               return

               * ======================================================================
               * Clear select list
               * In:  listno (short integer)

vb.clearselect:
               listno = oconv(cmnd[1,2], 'ISL')
               gosub check.list
               if err then return

               clearselect listno

               return

               * ======================================================================
               * Read select list
               * In:  listno (short integer)

vb.readlist:
               listno = oconv(cmnd[1,2], 'ISL')
               gosub check.list
               if err then return

               readlist response from listno else response = ''

               return

               * ======================================================================
               * Release lock
               * In:  fileno (short integer)
               *      id

vb.release:
               fno = oconv(cmnd[1,2], 'ISL')
               if fno then               ;* 0249
                  gosub check.file
                  if err then return
               end

               id = cmnd[3,99]

               begin case
                  case fno = 0
                     release

                  case id = ''
                     release files(fno)

                  case 1
                     release files(fno), id
               end case

               return

               * ======================================================================
               * Write record
               * In:  fileno (short integer)
               *      id_len (short integer)
               *      id
               *      data

vb.write:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id.len = oconv(cmnd[3,2], 'ISL')
               id = cmnd[5,id.len]

               write cmnd[5 + id.len, 99999999] to files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Write record, retaiining lock
               * In:  fileno (short integer)
               *      id_len (short integer)
               *      id
               *      data

vb.writeu:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id.len = oconv(cmnd[3,2], 'ISL')
               id = cmnd[5,id.len]

               writeu cmnd[5 + id.len, 99999999] to files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Delete record
               * In:  fileno (short integer)
               *      id

vb.delete:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id = cmnd[3,99]
               delete files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Delete record, retaining lock
               * In:  fileno (short integer)
               *      id

vb.deleteu:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id = cmnd[3,99]

               deleteu files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Call catalogued subroutine
               * In:  subr name len (short integer)
               *      subr name (rounded to 2 byte boundary)
               *      arg count (short integer)
               *      arg len (long integer)
               *      arg data (rounded to 2 byte boundary)
               *
               * Out: arg no (short integer)   Always in ascending arg no order
               *      arg len (long integer)
               *      arg data (rounded to 2 byte boundary)

vb.call:
               name.len = oconv(cmnd[1,2], 'ISL')
               if name.len < 1 or name.len > MAX.CALL.NAME.LEN then
                  abort.message = sysmsg(5263) ;* Invalid call name
                  server.error = SV$ON.ERROR
                  return
               end

               subr.name = cmnd[3,name.len]
               pos = 3 + name.len + bitand(name.len, 1)

               arg.count = oconv(cmnd[pos,2], 'ISL')
               pos += 2

               * Are we allowed to run this program?

               obj.flags = load.object(subr.name)
               if subr.name[1,1] = '$' or config("SDCLIENT") = 2 or kernel(K$SDNET, -1) then
                  if not(bitand(obj.flags, HDR.SDCALL.ALLOWED)) then
                     abort.message = sysmsg(5264, subr.name) ;* %1 cannot be called from a SDClient session
                     server.error = SV$ON.ERROR
                  end
               end

               if arg.count then
                  mat args = ''
                  for i = 1 to arg.count
                     arg.len = oconv(cmnd[pos,4], 'ILL')
                     pos += 4
                     args(i) = cmnd[pos,arg.len]
                     pos += arg.len + bitand(arg.len, 1)
                  next i

                  callv @subr.name, arg.count, args

                  * Now return values of changed arguments (if any)

                  for i = 1 to arg.count
                     if changed(args(i)) then
                        response := iconv(i, 'ISL') : iconv(len(args(i)), 'ILL') : args(i)
                        if bitand(len(args(i)), 1) then response := ' '
                     end
                  next i
               end else
                  call @subr.name
               end

               gosub reset.environment

               return

               * ======================================================================
               * Execute command
               * In:  Command string
               * Out: Command output

vb.execute:
               if config("SDCLIENT") # 0  or kernel(K$SDNET, -1) then
                  abort.message = sysmsg(5265) ;* Command execution is disabled
                  server.error = SV$ON.ERROR
                  return
               end

               execute cmnd capturing response
               st = @system.return.code
               return to return.status.set

               * ======================================================================
               * Response to input
               * In:  Command string
               * Should never happen as client end should detect this

vb.respond:
               server.error = SV$ERROR
               error.msg = sysmsg(5266) ;* Response to prompt sent when no prompt outstanding
               return

               * ======================================================================
               * End command
               * Should never happen as client end should detect this

vb.endcommand:
               server.error = SV$ERROR
               error.msg = sysmsg(5267) ;* End command request sent when no prompt outstanding
               return

               * ======================================================================
               * Network login, request 24 - RETIRED.  The Windows port's, 20 Aug
               * 2026 (its docs/SCRAM_AUTH.md phase 5); W.4 SCRAM phase 5 here,
               * 14 Sep 2026.
               *
               * THE CLEARTEXT LOGIN IS GONE AND THERE IS NO FALLBACK.  This
               * handler read a length-prefixed user name and password out of
               * the packet body and checked them against /etc/shadow through
               * login() - the password crossed the wire in clear.  Requests 47
               * and 48 replace it, and a client that still sends 24 is refused
               * rather than quietly served a weaker path.
               *
               * IT REFUSES HERE RATHER THAN BEING DROPPED FROM THE GATE ABOVE:
               * taking 24 out of that list would answer an old client with 5270
               * "Not logged in", which reads as a client bug rather than as a
               * protocol that moved.
               *
               * THE BODY IS NOT PARSED.  It still carries a password, so nothing
               * here reads it, copies it or lets it reach a variable.
               *
               * LINUX: the APILOGIN=0 branch went with it.  It trusted the Unix
               * socket peer's uid (linuxio.c getpeereid) in place of a password,
               * and its only client, SDConnectUDS, is removed from sdclilib in
               * the same change - the port has neither.
               *
               * The connection is dropped, as it was for a failed login.

vb.login:
               abort.message = sysmsg(5275) ;* Request no longer supported...
               server.error = SV$ON.ERROR
               done = @true

               return

               * ======================================================================
               * Login user for SDLocal connection

vb.local.login:
* 30 Sep 26 SD Core for Linux Solo (LSOLO 15) - SDConnectLocal IS DISABLED (Windows
*   Solo bd59940, owner 25 Sep 2026: "disable sdconnectlocal, they can login with
*   sdconnect instead").  Ruling 21 makes every session prove the account password;
*   this request carries none and the client libraries stay unchanged, so it cannot
*   be made to ask.  Measured here before the change: sdclilib's SDConnectLocal forks
*   "sd -Q" and HUNG (30 s and still waiting) instead of failing.  Refused the way
*   retired request 24 is, with one message naming what to use instead, audited, and
*   the connection ends.  The old body below is unreachable and goes with the
*   LSOLO 6 cleanup.
               abort.message = sysmsg(11021) ;* SDConnectLocal is not available... use SDConnect
               server.error = SV$ON.ERROR
               void kernel(K$AUDIT, 'API REFUSED request=25 SDConnectLocal - disabled in SD Core for Linux Solo')
               done = @true
               return
              * dsm 20240612 openpath @sdsys:@ds:'$LOGINS' to lgn.f else
              * dsm 20240612    abort.message = sysmsg(6050) ;* Cannot open $LOGINS register
              * dsm 20240612    server.error = SV$ON.ERROR
              * dsm 20240612    return
              * dsm 20240612 end

               * mab 20240219  read security.rec from lgn.f, '$SECURE' then
               * mab 20240219     = kernel(K$SECURE, security.rec<1>)
               * mab 20240219  end

               username = logname

               * mab 20240219 if kernel(K$SECURE, -1) then
               * dsm 20240612 readu lgn.rec from lgn.f, username else null
               * 20240219 mab user must be member of sdusers           
               if  not(is_grp_member(username,'sdusers')) then
                     server.error = SV$ON.ERROR
                     void kernel(K$AUDIT, 'API REFUSED user=' : username : ' reason=not a member of sdusers (local login)')
                     abort.message = sysmsg(5009) ;* This user is not registered for SD use
                     goto exit.vb.local.login
               end

               * dsm 20240612 lgn.rec<LGN$DATE> = date()
               * dsm 20240612 lgn.rec<LGN$TIME> = time()
               * dsm 20240612 recordlocku lgn.f, username
               * dsm 20240612 write lgn.rec to lgn.f, username

               logname = username
               * dsm 20240612 i = kernel(K$ADMINISTRATOR,lgn.rec<LGN$ADMIN>)
               * mab 20240219    end else      ;* System is insecure
               * mab 20240219      i = kernel(K$ADMINISTRATOR,1)    ;* All users are administrators
               * mab 20240219    end

exit.vb.local.login:
               * dsm 20240612close lgn.f
               if server.error = SV$OK then logged.in = @true
               else done = @true

               return

               * ======================================================================
               * SCRAM-SHA-256 login, client-first.  The Windows port's, 19 Aug
               * 2026 (its docs/SCRAM_AUTH.md phase 3); W.4 SCRAM phase 3 here.
               *
               * In:   n,,n=<user>,r=<client nonce>
               * Out:  r=<combined nonce>,s=<salt>,i=<iterations>
               *
               * NO PASSWORD CROSSES THE WIRE IN EITHER DIRECTION.  The server
               * publishes the salt and cost, the client answers a nonce, and a
               * capture yields an offline guess bounded by the iteration count.
               * THE SERVER DOES NOT RUN PBKDF2 HERE: it holds StoredKey, so login
               * costs two HMACs and a hash.
               *
               * THIS PROCESS IS STILL ROOT HERE (sdclient@.service), which is
               * what lets it read $cred, root:root 0700.

vb.scram.first:
               gosub scram.trim.body

               * A fresh exchange on an authenticated session is a client bug or
               * an attempt to change identity part way through.
               if logged.in then
                  scram.refuse.reason = 'sequence error - already authenticated'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               scram.stage = 0        ;* a restart abandons any exchange in flight

* 02 Oct 26 SD Core for Linux Solo (LSOLO 20, S.50) - THE LOGIN HOLD: no new API
*   session while BACKUP.ACCOUNT or RESTORE.ACCOUNT runs, as LOGIN refuses one.
*   Before any credential is looked at.  (vb.local.login is dead code here,
*   LSOLO 17, so it gets no copy of this check.)
               call !acc_hold('TEST', hold.info, hold.err)
               if hold.err # '' then
                  scram.refuse.reason = 'a backup or restore is running'
                  abort.message = sysmsg(hold.err<1,1>, hold.err<1,2>, hold.err<1,3>)
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

* 15 Sep 26 dm - S.19: THE GS2 HEADER FOLLOWS THE TRANSPORT; THE CLIENT DOES NOT
*   CHOOSE IT.  Every socket connection is TLS (gplsrc/sd_tlssrv.c) and must
*   bind the login to it with 'p=tls-exporter,,' (RFC 9266).  A session with no
*   TLS - a local pipe - has nothing to bind to and must say 'n,,'.  'y,,' is
*   refused everywhere.  A client that offered 'n,,' over TLS would be a
*   downgrade, so it is a malformed message here, not a weaker login.
               scram.cbind = SDEXT('', @FALSE, SD_TLS_CBIND)
               if scram.cbind = '' then scram.gs2 = 'n,,' else scram.gs2 = 'p=tls-exporter,,'
               if cmnd[1,len(scram.gs2)] # scram.gs2 then goto scram.bad.message

               scram.cfirst.bare = cmnd[len(scram.gs2)+1,99999999]

               * Exactly two attributes: RFC 5802 requires failing on an m=
               * extension, and counting commas makes that automatic.
               if count(scram.cfirst.bare, ',') # 1 then goto scram.bad.message

               scram.attr = field(scram.cfirst.bare, ',', 1)
               if scram.attr[1,2] # 'n=' then goto scram.bad.message
               username = scram.attr[3,99999999]

               * Taken before any check, so every refusal has a name to record.
               gosub scram.clean.name

               scram.attr = field(scram.cfirst.bare, ',', 2)
               if scram.attr[1,2] # 'r=' then goto scram.bad.message
               scram.cnonce = scram.attr[3,99999999]
               if scram.cnonce = '' then goto scram.bad.message

               * No =2C / =3D unescaping is needed: valid_os_name allows no
               * character that would have required it.
               if username = '' or username[1,1] = '$' then
                  scram.refuse.reason = 'unusable name'
                  goto scram.bad.cred
               end
               if not(valid_os_name(username)) then
                  scram.refuse.reason = 'name rejected by valid_os_name'
                  goto scram.bad.cred
               end

               openpath @sdsys:@ds:'$cred' to scram.cred.f else
                  scram.refuse.reason = 'cannot open $cred'
                  abort.message = sysmsg(5274) ;* Authentication service unavailable
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - RULING 19, as SD Core Solo for
*   Windows' vb.scram.first: THE ACCOUNT HAS TWO PASSWORDS AND ONE LOGIN NAME.
*   The user's own account password ($cred, keyed by the account name) and, in
*   managed mode, the master server's global password ($global).  The two
*   records SHARE A SALT (!CRED_SET keeps a record's own salt on a change - see
*   gpl.bp/set_password), so ONE server-first serves either, and the proof in
*   request 48 is checked against each StoredKey in turn.  Record ids are lower
*   case here (a case-sensitive filesystem; !CRED_SET writes them so).
*
*   $admin and $global can never be API logins: a name starting with '$' is
*   refused above.  SDSYS is never an API login (ruling 11), even though it is
*   in the register: it has no credential, and the global-password route below
*   admits only a name that is an account other than SDSYS.
               scram.gstored = ''
               scram.gserver = ''
               have.user = @false
               read scram.cred from scram.cred.f, downcase(username) then
                  have.user = @true
               end else
                  scram.cred = ''
               end
               have.global = @false
               read scram.gcred from scram.cred.f, '$global' then
                  if scram.gcred<CRED$VERSION> = SCRAM$CRED.VERSION then have.global = @true
               end else
                  scram.gcred = ''
               end
               close scram.cred.f

               if have.user then
                  * A version 1 record holds an Argon2 verifier and no StoredKey.
                  * It cannot drive a SCRAM exchange; the account has to set its
                  * password again.  !CRED_VERIFY refuses it too.
                  if scram.cred<CRED$VERSION> # SCRAM$CRED.VERSION then
                     scram.cred = ''
                     scram.gcred = ''
                     scram.refuse.reason = 'credential is version 1 - run SET.PASSWORD'
                     goto scram.bad.cred
                  end
                  scram.salt = scram.cred<CRED$SALT>
                  scram.iter = scram.cred<CRED$ITER>
                  scram.storedkey = scram.cred<CRED$STOREDKEY>
                  scram.serverkey = scram.cred<CRED$SERVERKEY>
                  if scram.storedkey = '' or scram.serverkey = '' then
                     scram.storedkey = ''
                     scram.serverkey = ''
                  end
               end else
                  * No account password of its own: the master may still log in
                  * under the name, but only the name of an account in the
                  * register, and never SDSYS.
                  in.register = @false
                  if have.global and downcase(username) # 'sdsys' then
                     openpath @sdsys:@ds:'accounts' to scram.acc.f then
                        read scram.acc.rec from scram.acc.f, downcase(username) then in.register = @true
                        close scram.acc.f
                     end
                  end
                  if not(in.register) then
                     scram.gcred = ''
                     scram.refuse.reason = 'no credential'
                     goto scram.bad.cred      ;* no credential - fail closed
                  end
                  scram.salt = scram.gcred<CRED$SALT>
                  scram.iter = scram.gcred<CRED$ITER>
                  scram.storedkey = ''
                  scram.serverkey = ''
               end
               if have.global then
                  if scram.gcred<CRED$SALT> = scram.salt and scram.gcred<CRED$ITER> = scram.iter then
                     scram.gstored = scram.gcred<CRED$STOREDKEY>
                     scram.gserver = scram.gcred<CRED$SERVERKEY>
                     if scram.gstored = '' or scram.gserver = '' then
                        scram.gstored = ''
                        scram.gserver = ''
                     end
                  end else
                     void kernel(K$AUDIT, 'API NOTE user=' : scram.audit.name : ' - $global does not share this account''s salt, so the global password cannot log in under this name')
                  end
               end
               scram.cred = ''
               scram.gcred = ''

               if scram.salt = '' or scram.iter = '' then
                  scram.refuse.reason = 'credential incomplete'
                  goto scram.bad.cred
               end
               if scram.storedkey = '' and scram.gstored = '' then
                  scram.refuse.reason = 'credential incomplete'
                  goto scram.bad.cred
               end

               * 18 random bytes: a multiple of three, so base64 has no '='
               * padding and every character is inside RFC 5802's printable set.
               scram.snonce = SDEXT('18', @TRUE, SD_RANDBYTES)
               if scram.snonce = '' then goto scram.crypto.failed

               scram.nonce = scram.cnonce : scram.snonce

               * Kept verbatim: server-first goes into AuthMessage byte for byte.
               scram.sfirst = 'r=' : scram.nonce : ',s=' : scram.salt : ',i=' : scram.iter

               scram.user = username
               scram.stage = 1
               response = scram.sfirst

               return

               * ======================================================================
               * SCRAM-SHA-256 login, client-final.  The port's.
               *
               * In:   c=biws,r=<combined nonce>,p=<ClientProof>
               * Out:  v=<ServerSignature>
               *
               * The server never holds ClientKey.  It recovers a candidate from
               * the proof and checks its SHA-256 against StoredKey.

vb.scram.final:
               gosub scram.trim.body

               if logged.in then
                  scram.refuse.reason = 'sequence error - already authenticated'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               * A client-final with no client-first has no nonce and no
               * AuthMessage: refusing is what stops a check against empty values.
               if scram.stage # 1 then
                  scram.refuse.reason = 'sequence error - no client-first'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               * ONE ATTEMPT PER CLIENT-FIRST, cleared before the proof is read.
               scram.stage = 0

               if count(cmnd, ',') # 2 then goto scram.bad.message

* 15 Sep 26 dm - S.19: c= is base64 of the GS2 header plus, over TLS, this
*   session's binding; 'biws' is base64('n,,').  Recomputed rather than carried
*   from client-first.  The client's copy must equal the server's: a login
*   relayed by a man in the middle carries the relay's binding, not this
*   session's, and the proof - computed over this attribute - fails with it.
               scram.cbind = SDEXT('', @FALSE, SD_TLS_CBIND)
               if scram.cbind = '' then scram.cattr = 'c=biws' else scram.cattr = 'c=' : scram.cbind
               scram.attr = field(cmnd, ',', 1)
               if scram.attr # scram.cattr then goto scram.bad.message

               scram.attr = field(cmnd, ',', 2)
               if scram.attr[1,2] # 'r=' then goto scram.bad.message

               * Exact match on the whole combined nonce: this kills replay.
               if scram.attr[3,99999999] # scram.nonce then goto scram.bad.message

               scram.cfinal.bare = scram.cattr : ',' : scram.attr

               scram.attr = field(cmnd, ',', 3)
               if scram.attr[1,2] # 'p=' then goto scram.bad.message
               scram.proof = scram.attr[3,99999999]
               if scram.proof = '' then goto scram.bad.message

               scram.authmsg = scram.cfirst.bare : ',' : scram.sfirst : ',' : scram.cfinal.bare

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - RULING 19: the proof is checked
*   against the user's StoredKey and, only if that fails, against $global's
*   (vb.scram.first kept it only when it shares the salt).  scram.check.proof
*   is the single check that used to stand here, run once per key; a global
*   match signs with the global ServerKey and unlocks the administrator
*   commands below.  Every failure from here is one answer.
               scram.via = ''
               scram.check.crypto = @false
               if scram.storedkey # '' then
                  scram.check.key = scram.storedkey
                  gosub scram.check.proof
                  if scram.check.ok then scram.via = 'user'
               end
               if scram.via = '' and scram.gstored # '' and not(scram.check.crypto) then
                  scram.check.key = scram.gstored
                  gosub scram.check.proof
                  if scram.check.ok then
                     scram.via = 'global'
                     scram.serverkey = scram.gserver
                  end
               end
               scram.check.key = ''
               scram.gstored = ''
               scram.gserver = ''
               if scram.check.crypto then goto scram.crypto.failed

               if scram.via = '' then
                  * The wrong password - the one refusal that means somebody
                  * knows the account exists.  (A malformed or wrong-length
                  * proof lands here too; it was never a separate answer.)
                  scram.refuse.reason = 'wrong password'
                  goto scram.bad.cred
               end

               * AUTHENTICATED.  The reply is a signature only a holder of this
               * account's ServerKey can compute - the mutual half.
               scram.ssig = SDEXT(scram.serverkey : @FM : scram.authmsg, @TRUE, SD_HMACSHA256)
               if scram.ssig = '' then goto scram.crypto.failed

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - THE GATES THAT STOOD HERE ARE GONE:
*   membership of sdusers (5009), membership of sdapi (10073) and the SDSYS door
*   (10174, 10922 - !peer_local and the socket peer's user).  There are no SD
*   groups and SDSYS is never an API login (ruling 11).  What decides who may use
*   the API is the credential itself: only an account that was given a password
*   (solo_password ACCOUNT) has a record to prove against, or - in managed mode -
*   the master's global password under an account's name.  The account the
*   session may then ENTER is decided at vb.account (own account only).

               * THE IDENTITY IS THE NAME THAT WAS PROVEN, UNCONDITIONALLY - no
               * APILOGIN branch.  The answer is taken, as the port's is (its
               * PRE_RELEASE_FIXES 99): K$SET.USERNAME reports the name as it
               * stands, so a refused or overlength name shows here.
               logname = scram.user
               set.name = kernel(K$SET.USERNAME, scram.user)
               if set.name # scram.user then
                  scram.refuse.reason = 'the session user name could not be set'
                  abort.message = sysmsg(10160)
                  * Authentication succeeded but the session could not take your user name
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               scram.storedkey = ''
               scram.serverkey = ''

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - NO K$ASSUME.USER: the API server
*   already runs as the one Linux user who owns the tree (it never was root
*   here), and the account the client proved, sduser, is not an operating
*   system user, so there is no identity to take.  It was the root-to-user drop
*   of the multi-user server (initgroups/setgid/setuid).

               response = 'v=' : scram.ssig
               logged.in = @true

* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - RULING 19 (with 12): THE GLOBAL
*   PASSWORD IS THE MASTER SERVER'S, AND IT CARRIES THE ADMINISTRATOR COMMANDS -
*   as ADMIN does when given the global password.  This program is $internal,
*   which is what K$ADMINISTRATOR requires to be set (op_kernel.c).  Audited
*   both ways.  30 Sep 26 LSOLO 12, ruling 33: the master's session is also
*   marked K$GLOBAL.SESSION so it may manage the global catalogue.
               if scram.via = 'global' then
                  if kernel(K$ADMINISTRATOR, 1) then
                     void kernel(K$GLOBAL.SESSION, 1)
                     void kernel(K$AUDIT, 'API LOGIN user=' : scram.user : ' via=global - administrator commands unlocked')
                  end else
                     void kernel(K$AUDIT, 'API LOGIN user=' : scram.user : ' via=global - administrator flag NOT set')
                  end
               end else
                  void kernel(K$AUDIT, 'API LOGIN user=' : scram.user : ' via=account')
               end

               return

               * ======================================================================
               * scram.check.proof - does scram.proof prove the password behind
               * scram.check.key (a StoredKey)?  29 Sep 26 SD Core for Linux Solo,
               * ruling 19: vb.scram.final's single check, lifted out so it can be
               * run once per key.  Constant time, as !CRED_VERIFY is.
               *
               * Out: scram.check.ok     @true only on a match
               *      scram.check.crypto @true if HMAC failed - a fault, not a guess

scram.check.proof:
               scram.check.ok = @false
               scram.csig = SDEXT(scram.check.key : @FM : scram.authmsg, @TRUE, SD_HMACSHA256)
               if scram.csig = '' then
                  scram.check.crypto = @true
                  return
               end
               scram.ckey = SDEXT(scram.proof : @FM : scram.csig, @TRUE, SD_XORBYTES)
               if scram.ckey = '' then return
               scram.derived = SDEXT(scram.ckey, @TRUE, SD_SHA256)
               scram.ckey = ''
               if scram.derived = '' then return
               if SDEXT(scram.derived : @FM : scram.check.key, @TRUE, SD_CTEQUAL) = '1' then scram.check.ok = @true
               return

               * ----------------------------------------------------------------------
               * Shared exits for both SCRAM handlers, the port's.

scram.bad.message:
               if scram.refuse.reason = '' then scram.refuse.reason = 'malformed authentication message'
               abort.message = sysmsg(5272) ;* Invalid authentication message
               server.error = SV$ON.ERROR
               goto exit.vb.scram.fail

scram.crypto.failed:
               if scram.refuse.reason = '' then scram.refuse.reason = 'authentication service failed'
               abort.message = sysmsg(5274) ;* Authentication service unavailable
               server.error = SV$ON.ERROR
               goto exit.vb.scram.fail

scram.bad.cred:
               * ONE MESSAGE AND ONE DELAY FOR EVERY CREDENTIAL FAILURE.  Known
               * gap, the port's "Still open": an account with no credential
               * fails at 47 and a wrong password at 48, so the round trip tells
               * them apart.
               if scram.refuse.reason = '' then scram.refuse.reason = 'credential'
               abort.message = sysmsg(5017) ;* Invalid username or password
               server.error = SV$ON.ERROR
               sleep 3
               goto exit.vb.scram.fail

exit.vb.scram.fail:
               * THE ONE PLACE A REFUSED SCRAM LOGIN IS RECORDED: every path out
               * of both handlers passes here, so a refusal added later is
               * audited whether or not its author thinks about the trail.
               if scram.refuse.reason # '' then
                  if scram.audit.name = '' then scram.audit.name = '(none)'
                  void kernel(K$AUDIT, 'API REFUSED user=' : scram.audit.name : ' reason=' : scram.refuse.reason)
                  scram.refuse.reason = ''
               end

               * The connection goes, as for a failed request 24.
               scram.stage = 0
               scram.storedkey = ''
               scram.serverkey = ''
               done = @true

               return

               * ----------------------------------------------------------------------
               * Drop trailing NULs from the request body.  The packet carries its
               * own length, but a client written from vb.login's two-byte padding
               * would put one inside the base64; NUL is not valid in SCRAM.

scram.trim.body:
               loop
               while cmnd # '' and cmnd[len(cmnd),1] = char(0)
                  cmnd = cmnd[1,len(cmnd)-1]
               repeat

               return

               * ----------------------------------------------------------------------
               * The presented user name, made safe for the audit trail (the
               * port's).  audit_message() writes verbatim and ends with a newline,
               * so a name carrying one would forge a line.  The permitted set is
               * valid_os_name's own; anything else becomes ?.

scram.clean.name:
               scram.cn.chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-'
               scram.cn.raw = username
               scram.cn.trunc = @false
               if len(scram.cn.raw) > MAX.USERNAME.LEN then
                  scram.cn.raw = scram.cn.raw[1, MAX.USERNAME.LEN]
                  scram.cn.trunc = @true
               end

               scram.cn.bad = convert(scram.cn.chars, '', scram.cn.raw)
               if scram.cn.bad # '' then
                  scram.cn.raw = convert(scram.cn.bad, str('?', len(scram.cn.bad)), scram.cn.raw)
               end

               scram.audit.name = scram.cn.raw
               if scram.audit.name = '' then scram.audit.name = '(empty)'
               if scram.cn.trunc then scram.audit.name := '...'
               return

               * ======================================================================
               * Select index
               * In:  file no  (short int)
               *      list no  (short int)
               *      index name len (short int)
               *      index name (padded to 2 byte interval)
               *      index value len (short int)
               *      index value (padded to 2 byte interval)

vb.selectindex:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               listno = oconv(cmnd[3,2], 'ISL')
               gosub check.list
               if err then return

               * Extract index name

               pos = 5
               n = oconv(cmnd[pos,2], 'ISL')
               pos += 2
               index.name = cmnd[pos, n]
               pos += n + bitand(n, 1)

               * Extract index value

               n = oconv(cmnd[pos,2], 'ISL')
               pos += 2
               index.value = cmnd[pos, n]

               selectindex index.name, index.value from files(fno) to listno

               return

                     * ======================================================================
                     * Open file SDNet file
                     * In:  Account name;filename
                     * Out: fileno (short integer)

vb.open.sdnet:
                     if not(bitand(config('NETFILES'), 2)) then
                        set.status ER$XREMOTE
                        server.error = SV$ELSE
                           return
                        end

                        * Use of this operation identifies the process as a SDNet user.
                        * Set the appropriate process flag so that LISTU etc show this.

                        i = kernel(K$SDNET, 1)

                        * Locate a spare file table entry

                        n = inmat(files)

                        for i = 1 to n
                           if not(fileinfo(files(i), FL$OPEN)) then goto vb.open.sdnet.continue
                        next i

                        * Extend file table

                        dim files(n + 50)
                        i = n + 1

vb.open.sdnet.continue:

                        * Open file to file table entry i

                        acc = field(cmnd, ';', 1)   ;* Account name or path
                        file = field(cmnd, ';', 1)  ;* File name

                        openpath @sdsys:@ds:'accounts' to acc.f then
                           read acc.rec from acc.f, downcase(acc) then
                              acc = parse.pathname.tokens(acc.rec<ACC$PATH>)
                           end
                           close acc.f
                        end

                        qvoc.path = acc:@ds:'voc'
                        openpath qvoc.path to qvoc.f else
                           server.error = SV$ELSE
                              return
                           end

                           file = field(cmnd, ';', 2)
                           if file[1,5] = 'DICT ' then
                              j = 3
                              file = file[6,999]
                           end else
                              j = 2
                           end

                           read voc.rec from qvoc.f, file else null
                           close qvoc.f

                           if voc.rec[1,1] # 'F' then
                              set.status ER$VNF
                              server.error = SV$ELSE
                                 return
                              end

                              path = voc.rec<j>
                              if path = '' then
                                 set.status ER$NPN
                                 server.error = SV$ELSE
                                    return
                                 end

                                 if upcase(path[1,6]) = '@SDSYS' then path = @sdsys:path[7,9999]

                                 if path[1,1] # @ds then
                                    * Convert voc item to absolute path
                                    path = acc : @ds : path
                                 end

                                 openpath path to files(i)
                                 on error server.error = SV$ON.ERROR
                                 then
                                    if bitand(fileinfo(files(i), FL$FLAGS), FL$FLAGS.TRUSTED) then
                                       server.error = SV$ELSE
                                       end else
                                          response = iconv(i, 'ISL')
                                       end
                                    end
                                    else server.error = SV$ELSE

                                       return

                                       * ======================================================================
                                       * Lock record
                                       * In:  fileno (short integer)
                                       *      flags (short integer)    0x0001 = Update lock, 0x0002 = no wait.
                                       *      id

vb.lock.record:
                                       fno = oconv(cmnd[1,2], 'ISL')
                                       gosub check.file
                                       if err then return

                                       flags = oconv(cmnd[3,2], 'ISL')

                                       id = cmnd[5,99]

                                       begin case
                                          case flags = 0
                                             recordlockl files(fno), id
                                          case flags = 1
                                             recordlocku files(fno), id
                                          case flags = 2
                                             recordlockl files(fno), id locked server.error = SV$LOCKED
                                             case flags = 3
                                                recordlocku files(fno), id locked server.error = SV$LOCKED
                                             end case

                                             return

                                             * ======================================================================
                                             * Clear file
                                             * In:  fileno (short integer)
                                             * Out:

vb.clearfile:
                                             fno = oconv(cmnd[1,2], 'ISL')
                                             gosub check.file
                                             if err then return

                                             clearfile files(i)

                                             return

                                             * ======================================================================
                                             * Get file lock
                                             * In:  fileno (short integer)
                                             *      Wait?  (short integer)
                                             * Out:

vb.filelock:
                                             fno = oconv(cmnd[1,2], 'ISL')
                                             wait = oconv(cmnd[3,2], 'ISL')
                                             gosub check.file
                                             if err then return

                                             if wait then
                                                filelock files(i)
                                             end else
                                                filelock files(i) locked server.error = SV$LOCKED
                                                end

                                                return

                                                * ======================================================================
                                                * Release file lock
                                                * In:  fileno (short integer)
                                                * Out:

vb.fileunlock:
                                                fno = oconv(cmnd[1,2], 'ISL')
                                                gosub check.file
                                                if err then return

                                                fileunlock files(i)

                                                return

                                                * ======================================================================
                                                * Test lock
                                                * In:  fileno (short integer)
