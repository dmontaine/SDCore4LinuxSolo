* ======================================================================
* Revision of the server (QMRevision), SD Core's handler.   Request 49 since 11 Nov 26
* In:
* Out: the revision, in the form SYSTEM(1012) gives it

vb.revision:
response = system(1012)
return

* ======================================================================
* SrvrSshKey  -  request 72 (was 49 until 11 Nov 26), the master's ssh key (LSOLO 19)
*
* In:  verb, FM, argument.  ADD key | REMOVE fingerprint | LIST.
* Out: ADD    user FM host FM key fingerprint FM ADDED|PRESENT FM sshd host-key fingerprint FM port
*      REMOVE REMOVED|ABSENT FM Solo lines left      LIST  one fingerprint per field
*
* 02 Oct 26 (LSOLO 29, owner: Solo's ssh has its own port, 4251): the host-key fingerprint is
* now SOLO'S OWN sshd's, not the machine's, and field 6 is the port to connect to.  Field 6 is
* new: a client that reads five fields is unaffected.  AGREED with SD Core for Windows (mailbox
* 2026-10-02T3510 / T3600): Windows Solo answers the same six fields, field 5 its own sshd's key.
*
* Owner, 30 Sep 2026 (managed mode: the master logs in over ssh as sduser with the
* global password and knows only the IP): the master asks the client to install its
* public key, and the reply names the OS user, so ssh can then name it.  Agreed with
* Windows Solo, which builds the same request and reply (mailbox, 30 Sep).  ONLY A
* GLOBAL SESSION (K$GLOBAL.SESSION, set at request 48 by a global proof): the account
* password and ADMIN are refused 14975.  The key never reaches a command line: it is
* written to a file and tools/solo-ssh.sh reads it, answering KEY=value lines in
* another file; that script alone edits authorized_keys, recognises its own lines by
* the forced command, and caps them at four.  Every verb is audited, with the peer's
* address (system(42)).
* ======================================================================
vb.sshkey:
if not(kernel(K$GLOBAL.SESSION, -1)) then
   server.error = SV$ERROR
   error.msg = sysmsg(14975) ;* Only the SD Core server may manage ssh keys
   void kernel(K$AUDIT, 'api sshkey refused - not a global session peer=' : system(42))
   return
end

ssh.verb = upcase(trim(cmnd<1>))
ssh.arg = cmnd<2>
if ssh.verb # 'ADD' and ssh.verb # 'REMOVE' and ssh.verb # 'LIST' then
   server.error = SV$ERROR
   error.msg = sysmsg(14976, 'unknown request, use ADD, REMOVE or LIST') ;* The ssh key request was refused: %1
   return
end

if ssh.verb # 'LIST' then
   ssh.bad = (ssh.arg = '' or len(ssh.arg) > 4096)
   if not(ssh.bad) then
      for ssh.i = 1 to len(ssh.arg)
         ssh.c = seq(ssh.arg[ssh.i, 1])
         if ssh.c < 32 or ssh.c > 126 then ssh.bad = @true ; exit
      next ssh.i
   end
   if ssh.bad then
      server.error = SV$ERROR
      error.msg = sysmsg(14976, 'the key or fingerprint is not valid') ;* The ssh key request was refused: %1
      void kernel(K$AUDIT, 'api sshkey ' : downcase(ssh.verb) : ' refused - the argument is empty, too long or not printable ascii peer=' : system(42))
      return
   end
end

ssh.base = @sdsys : '/ssh-api.' : @userno
ssh.in = ssh.base : '.in'
ssh.out = ssh.base : '.out'
os.execute 'rm -f "' : ssh.in : '" "' : ssh.out : '"'
if ssh.verb # 'LIST' then
   openseq ssh.in to ssh.f else
      create ssh.f else
         server.error = SV$ERROR
         error.msg = sysmsg(14976, 'the request could not be carried out') ;* The ssh key request was refused: %1
         void kernel(K$AUDIT, 'api sshkey ' : downcase(ssh.verb) : ' refused - cannot create the key file peer=' : system(42))
         return
      end
   end
   writeseq ssh.arg to ssh.f else null
   close ssh.f
end

ssh.sub = 'api-' : downcase(ssh.verb)
ssh.cmd = 'bash "' : @sdsys : '/tools/solo-ssh.sh" ' : ssh.sub : ' "' : @sdsys : '"'
if ssh.verb # 'LIST' then ssh.cmd := ' "' : ssh.in : '"'
os.execute ssh.cmd : ' > "' : ssh.out : '" 2>/dev/null'

ssh.user = '' ; ssh.host = '' ; ssh.fp = '' ; ssh.hostfp = '' ; ssh.port = '' ; ssh.result = ''
ssh.fps = '' ; ssh.left = '' ; ssh.err = ''
openseq ssh.out to ssh.f then
   loop
      readseq ssh.line from ssh.f else exit
      ssh.eq = index(ssh.line, '=', 1)
      if ssh.eq > 1 then
         ssh.k = ssh.line[1, ssh.eq - 1]
         ssh.v = trim(ssh.line[ssh.eq + 1, 9999])
         begin case
            case ssh.k = 'USER'     ; ssh.user = ssh.v
            case ssh.k = 'HOST'     ; ssh.host = ssh.v
            case ssh.k = 'HOSTFP'   ; ssh.hostfp = ssh.v
            case ssh.k = 'PORT'     ; ssh.port = ssh.v
            case ssh.k = 'FP'
               if ssh.verb = 'LIST' then ssh.fps<-1> = ssh.v else ssh.fp = ssh.v
            case ssh.k = 'REMAINING'; ssh.left = ssh.v
            case ssh.k = 'RESULT'   ; ssh.result = ssh.v
            case ssh.k = 'ERROR'    ; ssh.err = ssh.v
         end case
      end
   repeat
   close ssh.f
end
os.execute 'rm -f "' : ssh.in : '" "' : ssh.out : '"'

if ssh.err # '' or ssh.result = '' then
   ssh.code = field(ssh.err, ' ', 1)
   server.error = SV$ERROR
   begin case
      case ssh.code = 'INVALID' ; error.msg = sysmsg(14976, 'the key or fingerprint is not valid')
      case ssh.code = 'CAP'     ; error.msg = sysmsg(14976, 'four Solo ssh keys are already installed')
      case ssh.code = 'NOSSH'   ; error.msg = sysmsg(14976, 'ssh is not set up on this Solo')
      case 1                    ; error.msg = sysmsg(14976, 'the request could not be carried out')
   end case
   if ssh.err = '' then ssh.err = 'NO ANSWER from tools/solo-ssh.sh'
   void kernel(K$AUDIT, 'api sshkey ' : downcase(ssh.verb) : ' refused - ' : downcase(ssh.err) : ' peer=' : system(42))  ;* 07 Oct 26 PAL-24: the helper's error token is lower case here too
   return
end

begin case
   case ssh.verb = 'ADD'
      response = ssh.user : @fm : ssh.host : @fm : ssh.fp : @fm : ssh.result : @fm : ssh.hostfp : @fm : ssh.port
      void kernel(K$AUDIT, 'api sshkey add ' : downcase(ssh.result) : ' fp=' : ssh.fp : ' user=' : ssh.user : ' peer=' : system(42))
   case ssh.verb = 'REMOVE'
      response = ssh.result : @fm : ssh.left
      void kernel(K$AUDIT, 'api sshkey remove ' : downcase(ssh.result) : ' fp=' : ssh.arg[1, 100] : ' remaining=' : ssh.left : ' peer=' : system(42))
   case 1
      response = ssh.fps
      void kernel(K$AUDIT, 'api sshkey list ' : dcount(ssh.fps, @fm) : ' key(s) peer=' : system(42))
end case
return

* ======================================================================
* 11 Nov 26 SD Core for Linux Solo - requests 50 to 69, carried from SD Core for Linux (15 Oct 26) with SD Core's numbers.  The texts
* below are SD Core's as they stand after its 28 and 31 Oct 26 changes (CLOSE, not CLOSESEQ; the A, S and C item types gone), which
* this tree has too.  Where SD Core asks a gate this product does not have, Solo's own rule is asked instead, marked "Solo:".
* ======================================================================
* Value of an @-variable (QMGetVar).   Sheet 195
* In:  name, with or without the @, in either case
* Out: the value as a string, or the null string for a name that is not one of those below.  The names are the ones a
*      session can have a use for; each is something the account's own programs read as freely.

vb.getvar:
gv.name = upcase(trim(cmnd))
if gv.name[1,1] = '@' then gv.name = gv.name[2,99]
begin case
   case gv.name = 'SELECTED'            ; response = @selected
   case gv.name = 'LOGNAME' or gv.name = 'USER' ; response = @logname
   case gv.name = 'WHO'                 ; response = @who
   case gv.name = 'PATH'                ; response = @path
   case gv.name = 'USERNO'              ; response = @userno
   case gv.name = 'TTY'                 ; response = @tty
   case gv.name = 'DS'                  ; response = @ds
   case gv.name = 'SENTENCE'            ; response = @sentence
   case gv.name = 'COMMAND'             ; response = @command
   case gv.name = 'SYSTEM.RETURN.CODE'  ; response = @system.return.code
   case gv.name = 'USER.RETURN.CODE'    ; response = @user.return.code
   case gv.name = 'DATE'                ; response = @date
   case gv.name = 'TIME'                ; response = @time
   case gv.name = 'ID'                  ; response = @id
   case gv.name = 'ANS'                 ; response = @ans
   case gv.name = 'USER0' ; response = @user0
   case gv.name = 'USER1' ; response = @user1
   case gv.name = 'USER2' ; response = @user2
   case gv.name = 'USER3' ; response = @user3
   case gv.name = 'USER4' ; response = @user4
   case 1                               ; response = ''
end case
return

* ======================================================================
* SYSTEM() (QMSystem).   Sheet 499
* In:  key (long integer)
* Out: the value as a string

vb.system:
response = system(oconv(cmnd[1,4], 'ILL'))
return

* ======================================================================
* Transactions (QMTxn).   Sheet 442
* In:  mode (short integer): 1 start, 2 commit, 3 abort, 4 commit non-durable (a nested transaction goes to its parent)
* Commit and abort need a transaction to be running.

vb.txn:
tx.mode = oconv(cmnd[1,2], 'ISL')
if tx.mode < 1 or tx.mode > 4 or (tx.mode > 1 and not(@transaction.id)) then
   server.error = SV$ERROR
   error.msg = sysmsg(11340) ;* Transaction mode must be 1 to 4, and 2 to 4 need a transaction
   return
end
begin case
   case tx.mode = 1
      transaction start
   case tx.mode = 2
      transaction commit
   case tx.mode = 3
      transaction abort
   case 1
      void kernel(K$NON.DURABLE.TXN, 1)
      transaction commit
end case
return

* ======================================================================
* Evaluate a dictionary item (QMEvaluate, QMEvalConv).   Sheets 247 (EvalConv) and 409
* In:  file number of a DICTIONARY (short), name length (short), name(s) - several are separated by value marks -,
*      data length (long), the data, the record id
* Out: the value of each item, joined by item marks.  The data becomes @RECORD and the id @ID for the evaluation.
* An item that is not in the dictionary is the ELSE case; one that is not a data defining item (type D or I) or does not
* compile is an error.  QMEvalConv also applies the item's output conversion, to each value of a multivalued answer.  An
* I-type that is not compiled is compiled for this call and the dictionary is NOT written to (a request that reads must not write).
* No file number can exist when SDCLIENT is set or SDNet is in use (vb.open refuses), so no restricted session can reach this.

vb.evaluate:
ev.conv = @false
goto evaluate.common

vb.evalconv:
ev.conv = @true

evaluate.common:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.file
if err then return

ev.n = oconv(cmnd[3,2], 'ISL')
ev.names = cmnd[5,ev.n]
ev.p = 5 + ev.n
ev.n = oconv(cmnd[ev.p,4], 'ILL')
ev.data = cmnd[ev.p + 4,ev.n]
ev.id = cmnd[ev.p + 4 + ev.n,len(cmnd)]

response = ''
ev.count = count(ev.names, @vm) + 1
for ev.i = 1 to ev.count
   ev.name = ev.names<1,ev.i>
   gosub evaluate.item
   if server.error # SV$OK then
      response = ''
      return
   end
   if ev.i > 1 then response := @im
   response := ev.result
next ev.i
return

* One item: ev.name evaluated against ev.data and ev.id; the answer in ev.result, or server.error and error.msg
evaluate.item:
ev.result = ''
read ev.rec from files(fno), ev.name else
   read ev.rec from files(fno), downcase(ev.name) else
      read ev.rec from files(fno), upcase(ev.name) else
         server.error = SV$ELSE
         return
      end
   end
end

ev.type = upcase(ev.rec[1,1])
if index('DI', ev.type, 1) = 0 or ev.type = '' then      ;* 31 Oct 26: the A and S item types are gone
   server.error = SV$ERROR
   error.msg = sysmsg(11342, ev.name) ;* %1 is not a dictionary item that defines data
   return
end

* Compile what is calculated and not yet compiled, the way the query processor decides it is (qproc: no object code, or the
* checksum no longer matches the record)
if ev.type = 'I' then
   sys.chk.rec = ev.rec ; sys.chk.rec<DICT.SYS.INFO,1> = ''   ;* 28 Oct 26 S.87: REPLACE() is gone
   if len(ev.rec<DICT.ITYPE.OBJECT>) = 0 ~
   or checksum(sys.chk.rec) # ev.rec<DICT.SYS.INFO,1> then
      call $dcomp(files(fno), ev.name, ev.rec, ev.z, ev.z, ev.z, ev.z, ev.z, 1)
      if ev.rec<DICT.ITYPE.OBJECT> = '' then
         server.error = SV$ERROR
         error.msg = sysmsg(11341, ev.name) ;* %1 cannot be compiled
         return
      end
   end
end

ev.saved.id = @id
ev.saved.record = @record
@id = ev.id
@record = ev.data
set.status 0
ev.result = itype(ev.rec)
ev.status = status()
set.status 0                   ;* what the expression left behind is not the request's status; a conversion below sets it
@id = ev.saved.id
@record = ev.saved.record
if ev.status = ER$INVA.ITYPE then
   server.error = SV$ERROR
   error.msg = sysmsg(11342, ev.name) ;* %1 is not a dictionary item that defines data
   ev.result = ''
   return
end

if ev.conv then
   ev.cv = ev.rec<DICT.CONV>
   if ev.cv # '' then ev.result = oconvs(ev.result, ev.cv)
end
return

* ======================================================================
* ICONV(), OCONV(), ICONVS(), OCONVS() (QMIConv, QMOConv, QMIConvs, QMOConvs).   Sheet 409
* In:  conversion code length (short), the code, the data
* Out: the converted data; the STATUS() of the conversion goes back as the request's status, as ICONV and OCONV leave it
* A conversion reads a file (T with a ;) or calls a program (U): where SDCLIENT is set or SDNet is in use, which refuse both
* to the client, such a code is refused.

vb.iconv:
cv.mode = 1
goto conv.common

vb.oconv:
cv.mode = 2
goto conv.common

vb.iconvs:
cv.mode = 3
goto conv.common

vb.oconvs:
cv.mode = 4

conv.common:
cv.n = oconv(cmnd[1,2], 'ISL')
cv.code = cmnd[3,cv.n]
cv.data = cmnd[3 + cv.n,len(cmnd)]

if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   cv.count = count(cv.code, @vm) + 1
   for cv.i = 1 to cv.count
      cv.seg = upcase(trimf(cv.code<1,cv.i>))
      if cv.seg[1,1] = 'U' or (cv.seg[1,1] = 'T' and index(cv.seg, ';', 1)) then
         server.error = SV$ERROR
         error.msg = sysmsg(11343) ;* A conversion that reads a file or calls a program is not allowed here
         return
      end
   next cv.i
end

begin case
   case cv.mode = 1
      response = iconv(cv.data, cv.code)
   case cv.mode = 2
      response = oconv(cv.data, cv.code)
   case cv.mode = 3
      response = iconvs(cv.data, cv.code)
   case 1
      response = oconvs(cv.data, cv.code)
end case
return

* ======================================================================
* Sequential files (QMOpenSeq, QMReadSeq, QMReadBlk, QMWriteSeq, QMWriteBlk, QMSeek, QMWeofSeq; closed by the ordinary close).
* Sheet 441.  A sequential file's number is SEQ.BASE + its slot, apart from the files of vb.open.
*
* THE GATES.  The session may not open a sequential file when SDCLIENT is set or SDNet is in use (as for any file).  A file named
* through the VOC (file name and record id) is an SD directory file, opened as OPENSEQ opens it for any program, and one flagged
* trusted is refused.  A BARE PATHNAME (a null id) is an operating system file: this program is $internal, which the kernel
* does not hold to the OS-access gate, so the gate is asked here, as the account's own programs are asked it by OPENSEQ -
* without the account's OS switch (SET.OS.ACCESS) the session reaches only its own account's directory.
*
* vb.openseq   In:  modes (long), name length (short), name, id (null: the name is a pathname)
*                   modes: 2 give up with a locked answer if another process has the file (without it, wait), 16 read only,
*                   256 append, 512 overwrite, 1024 flush every line written, 4096 shared (append, for several writers)
*              Out: the file number, or the ELSE case with STATUS() saying why

vb.openseq:
if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   abort.message = sysmsg(5262) ;* File access is disabled
   server.error = SV$ON.ERROR
   return
end

os.modes = oconv(cmnd[1,4], 'ILL')
os.n = oconv(cmnd[5,2], 'ISL')
os.name = cmnd[7,os.n]
os.id = cmnd[7 + os.n,len(cmnd)]
if os.name = '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11346) ;* A sequential file needs a name
   return
end

os.slot = 0
for os.i = 1 to SEQ.MAX
   if not(seq.state(os.i)) then
      os.slot = os.i
      exit
   end
next os.i
if os.slot = 0 then
   server.error = SV$ERROR
   error.msg = sysmsg(11344) ;* Too many sequential files are open
   return
end

if os.id = '' then
   os.path = @true
   if not(kernel(K$PATH.OK, os.name)) then
      server.error = SV$ERROR
      error.msg = sysmsg(11345, os.name) ;* %1 is not a file this account may open
      return
   end
   os.edit.ok = @true   ;* Solo: there is no pathname form of !voc_refusal (SD Core asks K$EDIT.OS.OK here); see below
end else
   os.path = @false
   open os.name to os.tf else
      server.error = SV$ELSE
      return
   end
   os.trusted = bitand(fileinfo(os.tf, FL$FLAGS), FL$FLAGS.TRUSTED)
   os.edit.ok = (voc_refusal(os.tf) = 0)   ;* Solo: the VOC rule, asked of the file that is open, before it is closed (SD Core: K$EDIT.OK)
   close os.tf
   if os.trusted then
      server.error = SV$ELSE
      return
   end
end

os.m = 0
begin case
   case bitand(os.modes, 16)   ; os.m = 1
   case bitand(os.modes, 4096) ; os.m = 4
   case bitand(os.modes, 512)  ; os.m = 3
   case bitand(os.modes, 256)  ; os.m = 2
end case

* SD Core 17 Oct 26 (S.64 part 2), mapped to Solo 11 Nov 26.  This program is $internal, so the rule for what a session may change is
*   asked here: a record of a file that !voc_refusal will not let this session change (the VOC without ADMIN; SDSYS's gcat,
*   global.bp.out and solo.policy without the global session) is opened for reading only - nothing is made and nothing written (a
*   write then takes the ELSE case).  Reading is not refused, because the default mode is read and write.  A bare pathname is held
*   only to the OS switch (K$PATH.OK above), as a user program's OPENSEQ of a pathname is.
if not(os.edit.ok) then os.m = 1

loop
   os.lk = 0
   os.ex = 0
   gosub seq.open.once
until not(os.lk) or bitand(os.modes, 2)
   nap 1000                                 ;* the lock is another process's: wait a second, as the mode asks (NAP, not SLEEP:
                                            ;* test-failaudit-units.py holds the file to one SLEEP, the scram delay)
repeat

if os.lk then
   server.error = SV$LOCKED
   return
end
os.st = status()
if not(os.ex) and os.st # 0 then            ;* neither there nor made: the open failed
   server.error = SV$ELSE
   return
end

seq.state(os.slot) = 1
seq.unbuf(os.slot) = (bitand(os.modes, 1024) # 0)
response = iconv(SEQ.BASE + os.slot, 'ISL')
return

* One try at the open: os.lk is set when the file is locked by another process, os.ex when it was there already
seq.open.once:
begin case
   case os.path and os.m = 0
      openseq os.name to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 1
      openseq os.name readonly to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 2
      openseq os.name append to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 3
      openseq os.name overwrite to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path
      openseq os.name shared to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 0
      openseq os.name, os.id to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 1
      openseq os.name, os.id readonly to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 2
      openseq os.name, os.id append to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 3
      openseq os.name, os.id overwrite to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case 1
      openseq os.name, os.id shared to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
end case
return

* The file number of a request, as an index into the table: err is set, with the reply, for one that is not an open sequential file
check.seq:
err = @true
si = fno - SEQ.BASE
if si < 1 or si > SEQ.MAX then
   server.error = SV$ERROR
   error.msg = sysmsg(5268) ;* Invalid file number
   return
end
if not(seq.state(si)) then
   server.error = SV$ERROR
   error.msg = sysmsg(5268)
   return
end
err = @false
return

* ReadSeq.  In: fno (short).  Out: the next line without its terminator; the ELSE case at the end of the file
vb.readseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
readseq rec from seqfiles(si) on error server.error = SV$ON.ERROR then response = rec else server.error = SV$ELSE
return

* ReadBlk.  In: fno (short), bytes (long).  Out: up to that many bytes; the ELSE case when there are none
vb.readblk:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
rb.n = oconv(cmnd[3,4], 'ILL')
if rb.n < 1 or rb.n > 100000000 then
   server.error = SV$ERROR
   error.msg = sysmsg(11347) ;* The number of bytes to read is from 1 to 100000000
   return
end
readblk rec from seqfiles(si), rb.n on error server.error = SV$ON.ERROR then response = rec else server.error = SV$ELSE
return

* WriteSeq.  In: fno (short), the line.  A file opened unbuffered is flushed after each line.
vb.writeseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
ws.data = cmnd[3,len(cmnd)]
if seq.unbuf(si) then
   writeseqf ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
end else
   writeseq ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
end
return

* WriteBlk.  In: fno (short), the bytes: written exactly as given, no terminator added
vb.writeblk:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
ws.data = cmnd[3,len(cmnd)]
writeblk ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
if seq.unbuf(si) then flush seqfiles(si) then null else null
return

* Seek.  In: fno (short), offset (signed long), relative to (short): 0 start, 1 here, 2 end
vb.seek:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
sk.off = oconv(cmnd[3,4], 'ILL')
if sk.off > 2147483647 then sk.off -= 4294967296
sk.rel = oconv(cmnd[7,2], 'ISL')
seek seqfiles(si), sk.off, sk.rel then null else server.error = SV$ELSE
return

* WeofSeq.  In: fno (short).  The file is cut off at the current position.
vb.weofseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
weofseq seqfiles(si)
return

* ======================================================================
* WRITE ... CREATING.SEQKEY (QMWriteSeqKey, QMWriteuSeqKey).   Sheet 441.  Requests 68 and 69: a global-password session only (the gate
* before the dispatch, 11 Nov 26), so the client library's SDWriteSeqKey works against a Solo server only from such a session.
* In:  fileno (short integer), the record
* Out: the id the file's counter gave it.  A hashed file only.  The update lock the write takes is released before the reply, or,
*      for the writeu request, kept.

vb.writeseqkey:
wk.keep = @false
goto writeseqkey.common

vb.writeuseqkey:
wk.keep = @true

writeseqkey.common:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.file
if err then return
gosub check.voc.edit   ;* SD Core asks check.edit (its S.64 edit gates); Solo's rule is the VOC and the global files (check.voc.edit), as for every other write here
if err then return
if fileinfo(files(fno), FL$TYPE) # FL$TYPE.DH then
   server.error = SV$ERROR
   error.msg = sysmsg(11348) ;* WRITE ... CREATING.SEQKEY needs a hashed file
   return
end
wk.data = cmnd[3,len(cmnd)]
wk.id = ''
if wk.keep then
   writeu wk.data to files(fno) creating.seqkey wk.id on error server.error = SV$ON.ERROR
end else
   write wk.data to files(fno) creating.seqkey wk.id on error server.error = SV$ON.ERROR
end
if server.error = SV$OK then response = wk.id
return

* ======================================================================
* FILEADMIN (request 70)  -  SD Core's S.73 item 3 (21 Oct 26), carried 11 Nov 26.  A server verb run FOR THE SESSION, built narrow because it is a new door.  On Solo the session is a
* global-password one (the gate before the dispatch): the master server administering this Solo.
* In:  operation (short integer), file number (short integer; 0 for the operation that names no open file), the verb's words (text)
* Out: what the verb printed (captured); an ON ERROR reply with its own text for a refusal
*
* THE VERB IS CHOSEN BY THE OPERATION NUMBER AND NEVER FROM THE TEXT: 1 analyse.file, 2 configure.file, 3 create.index, 4 build.index, 5 delete.index, 6 disable.index,
* 8 create.file, 9 delete.file (7 is free: there is no enable.index, build.index switches an index on again).  The file an operation works on is NAMED BY THE OPEN FILE
* (the name it was opened under, kept in file.names), so the caller cannot name a file it did not open; operation 8 names a NEW file, in the first word of the text.
* The words are checked by fa.check.words before anything runs: letters, digits and . _ - only, single blanks, at most 200 characters, never PATHNAME, LPTR, FORCE or
* NO.QUERY, and DIRECTORY only as the LAST word (it makes a directory file; a word after it would name a path).  A word the verb does not know is passed on as a name and
* the verb refuses it.  The command runs in the account the session entered, so the verb's own refusals apply (and check.voc.edit, Solo's rule for a change of the VOC and
* the global files, for every operation that changes the file).  NO.QUERY is added for the two verbs that ask (create.file, delete.file).  The file is CLOSED here before
* the verb runs - the verbs need the file to themselves and this process's handle would be one more opener - and opened again afterwards under the same file number, unless
* the file was deleted.  The audit line is written BEFORE the command runs, so a command that is killed is still on the trail.

vb.fileadmin:
fa.op = oconv(cmnd[1,2], 'ISL')
fno = oconv(cmnd[3,2], 'ISL')
fa.text = cmnd[5,len(cmnd)]
if config("SDCLIENT") # 0 or kernel(K$SDNET, -1) then
   abort.message = sysmsg(5265) ;* Command execution is disabled
   server.error = SV$ON.ERROR
   return
end
fa.verb = ''
if fa.op >= 1 and fa.op <= 9 then
*  11 Nov 26: operation 1 runs ANALYZE.FILE.  SD Core's text says analyse.file, which S.87 took out of every VOC (sdsys/voc_removed/analyse.file), so on SD Core and on the
*  first run of this carry the request answered "analyse.file is not in your VOC" (sandbox-fileadmin-solo.py G3).  The audit line names the verb that ran.
   fa.verb = field('analyze.file,configure.file,create.index,build.index,delete.index,disable.index,,create.file,delete.file', ',', fa.op)
end
if fa.verb = '' then
   abort.message = sysmsg(11531, fa.op) ;* %1 is not a remote file administration operation
   server.error = SV$ON.ERROR
   return
end
fa.names.file = (fa.op # 8)
fa.name = ''
if fa.names.file then
   gosub check.file
   if err then return
   fa.name = file.names<fno>
   if fa.name = '' then
      server.error = SV$ERROR
      error.msg = sysmsg(5268) ;* Invalid file number
      return
   end
   if fa.op # 1 then   ;* every operation but the report changes the file
      gosub check.voc.edit
      if err then return
   end
end
gosub fa.check.words
if fa.bad # '' then
   abort.message = sysmsg(11530, fa.bad) ;* "%1" is not accepted here: names, numbers and the verb's keywords only (no path, no quote)
   server.error = SV$ON.ERROR
   return
end
if fa.names.file then fa.shown = fa.name else fa.shown = field(fa.text, ' ', 1)
void kernel(K$AUDIT, 'api admin request=70 op=' : fa.verb : ' file=' : fa.shown : ' user=' : @logname)  ;* @logname, not logname: a plain variable does not survive an abort
fa.cmd = fa.verb
if fa.names.file then fa.cmd := ' ' : fa.name
if fa.text # '' then fa.cmd := ' ' : fa.text
if fa.op = 8 or fa.op = 9 then fa.cmd := ' no.query'
if fa.names.file then close files(fno)
execute fa.cmd capturing response
st = @system.return.code
* 8 Nov 26: ONE reopen for every operation.  A delete that worked leaves nothing to open, so the number is forgotten; a delete the verb refused leaves the file,
*   which opens again under the same number, and the client's handle stays good.
if fa.names.file then
   if upcase(fa.name[1,5]) = 'DICT ' then
      open 'DICT', trim(fa.name[6,9999]) to files(fno) else file.names<fno> = ''
   end else
      open fa.name to files(fno) else file.names<fno> = ''
   end
end
return to return.status.set

* ---- FA.CHECK.WORDS  -  fa.bad is '' when every word of fa.text may go to the verb, otherwise the first word that may not (or a note for two blanks and a long text)
fa.check.words:
fa.bad = ''
if len(fa.text) > 200 then
   fa.bad = fa.text[1,20] : '...'
   return
end
if fa.text = '' then return
fa.allowed = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-'
fa.n.words = dcount(fa.text, ' ')
for fa.w = 1 to fa.n.words
   fa.tok = field(fa.text, ' ', fa.w)
   fa.tok.ok = (fa.tok # '')
   for fa.c = 1 to len(fa.tok)
      if index(fa.allowed, fa.tok[fa.c,1], 1) = 0 then fa.tok.ok = @false
   next fa.c
   if fa.tok.ok then
      if index(',PATHNAME,LPTR,FORCE,NO.QUERY,', ',' : upcase(fa.tok) : ',', 1) then fa.tok.ok = @false
      if upcase(fa.tok) = 'DIRECTORY' and fa.w # fa.n.words then fa.tok.ok = @false
   end
   if not(fa.tok.ok) and fa.bad = '' then
      if fa.tok = '' then fa.bad = '(two blanks)' else fa.bad = fa.tok
   end
next fa.w
return

* ======================================================================
* FCONTROL (request 71)  -  SD Core's S.73 item 3 (21 Oct 26), carried 11 Nov 26.  The public FCONTROL(file, key {, value}) of an open file; a global-password session only.
* In:  fileno (short integer), key (short integer), the value (text; empty when the call had none)
* Out: what the function returned.  The keys are the FC$ keys of keys.h; one the function does not know is its own error.
* Every key but FC$VALID.ID (a question) changes the file or its counter, so check.voc.edit is asked first, as for every other change here.

vb.fcontrol:
fno = oconv(cmnd[1,2], 'ISL')
fc.key = oconv(cmnd[3,2], 'ISL')
fc.value = cmnd[5,len(cmnd)]
gosub check.file
if err then return
if fc.key # FC$VALID.ID then
   gosub check.voc.edit
   if err then return
end
if fc.value = '' then
   response = fcontrol(files(fno), fc.key)
end else
   response = fcontrol(files(fno), fc.key, fc.value)
end
return

* ======================================================================
* TRANS() (QMTrans, QMRTrans).   Sheet 499
* In:  file name length (short), file name, field name length (short), field name, action length (short), action, record id
* Out: the data; QMTrans lowers the mark characters one level, QMRTrans leaves them
* Opened as vb.open opens a file: not at all for SDCLIENT or SDNet, and a file or dictionary flagged trusted is refused.
* The B action (binary open) is not supported.

vb.trans:
tr.lower = @true
goto trans.common

vb.rtrans:
tr.lower = @false

trans.common:
if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   abort.message = sysmsg(5262) ;* File access is disabled
   server.error = SV$ON.ERROR
   return
end

tr.n = oconv(cmnd[1,2], 'ISL')
tr.file = cmnd[3,tr.n]
tr.p = 3 + tr.n
tr.n = oconv(cmnd[tr.p,2], 'ISL')
tr.field = cmnd[tr.p + 2,tr.n]
tr.p = tr.p + 2 + tr.n
tr.n = oconv(cmnd[tr.p,2], 'ISL')
tr.action = upcase(cmnd[tr.p + 2,tr.n])
tr.id = cmnd[tr.p + 2 + tr.n,999999]

if tr.action = '' then tr.action = 'X'
if tr.file = '' or convert('CX', '', tr.action) # '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11339) ;* The action of Trans is C or X (the B action is not supported)
   return
end

open tr.file to tr.f else
   server.error = SV$ELSE
   return
end
tr.trusted = bitand(fileinfo(tr.f, FL$FLAGS), FL$FLAGS.TRUSTED)
close tr.f
if tr.trusted then
   server.error = SV$ELSE
   return
end

if tr.field matches '1N0N' or tr.field = '-1' then
   tr.field = tr.field + 0                      ;* a field position, or -1 for the whole record
end else
   open 'DICT', tr.file to tr.d else
      server.error = SV$ELSE
      return
   end
   tr.trusted = bitand(fileinfo(tr.d, FL$FLAGS), FL$FLAGS.TRUSTED)
   close tr.d
   if tr.trusted then
      server.error = SV$ELSE
      return
   end
end

* SD's TRANS() lowers the marks of what it finds by one level (a record's field marks come back as value marks), because its
* result is meant to sit inside a list.  QMRTrans wants the marks as they are, so each record's answer is raised again; the
* answers of a list of ids are then joined with value marks: QMTrans lowers the marks of each record's data once and joins the
* records with value marks, QMRTrans joins them as they are (so one multivalued field and several single valued ones look alike).
response = ''
tr.ids = count(tr.id, @vm) + 1
for tr.i = 1 to tr.ids
   tr.one = raise(trans(tr.file, tr.id<1, tr.i>, tr.field, tr.action))
   if tr.lower then tr.one = lower(tr.one)
   if tr.i > 1 then response := @vm
   response := tr.one
next tr.i
return

