* START-HISTORY:
* 09 Nov 26 SD Core for Linux Solo (Solo carry 22, SD Core's S.87 fb98cfb5 took the * and - global
*           prefixes away; the Windows agent's T1420, as Windows Solo did in 97debab3) - a server's
*           program is catalogued under its PLAIN name and called as CALL name; a gcat entry with no
*           $ ! _ prefix is the server's (a left-over *name entry is swept as stale); a name in
*           global.bp.out that begins with $ ! _ * or - is refused, so SD's own programs are never
*           touched.  A local program of the same name is found first (object.c tries the local
*           catalogue for every name without a $ ! _ prefix).
* 08 Oct 26 SD Core for Linux Solo (LSOLO 46) - a server's program is catalogued as *name in
*           LOWER case (it was *NAME, which the loader no longer finds since PAL-1 stage 3a);
*           stale entries are compared by their stored name, so an upper-case one goes.
* 06 Oct 26 SD Core for Linux Solo (LSOLO 38) - no "standalone" mode: with no
*           $global it says so in new words (the same on SD Core Solo for Windows).
* 30 Sep 26 SD Core for Linux Solo (LSOLO 12) - ported; message 11028/11029,
*           $cred record $global (lower case), catalogue names upper case.
* 28 Sep 26 SD Core Solo - new, ruling 33.
* END-HISTORY
*
*
* START-DESCRIPTION:
*
*    SYNC.GLOBAL.CATALOG
*
* Owner's ruling 33, 28 Sep 2026: "the sduser, even in admin mode should not
* have access to the global catalog. however in managed mode there should be a
* GLOBAL.BP file that only the global password can administer and global
* catalog should be the catalog of programs in that file", and then: only
* object code, GLOBAL.BP.OUT, no source; "cataloged at installation and then
* the catalog automatically managed when the server adds or deletes items from
* global.bp.out. if necessary create a command usable only by the server".
* This is that command.
*
* WHAT IT DOES.  Makes the global catalogue's server entries match GLOBAL.BP.OUT
* (SDSYS's global.bp.out, which starts empty - the owner chose that the server
* fills it after installing):
*   - every object in GLOBAL.BP.OUT is catalogued under its plain name, lower case as CATALOG
*     does on Linux - written whole, so a changed object replaces the old one; a name that
*     begins with $ ! _ * or - is refused;
*   - every entry in the global catalogue with no $ ! _ prefix and no object in GLOBAL.BP.OUT
*     is deleted (an old *name entry from before 9 Nov 26 included).
* THE ABSENCE OF A $ ! _ PREFIX IS THE WHOLE BOOKKEEPING.  Nothing else can put such an entry
* in the global catalogue - CATALOG and DELETE.CATALOG refuse every global entry for every
* session (11029), and every program SD ships has a $ ! or _ name - so those entries ARE this
* command's, and SD's own programs are never touched.  A program catalogued locally under the
* same name is found first.  An upgrade replaces gcat wholesale, which drops the server's
* entries; the installer runs this afterwards and they come back from GLOBAL.BP.OUT, which an
* upgrade keeps.
*
* WHO MAY RUN IT: a session signed in with the global password
* (K$GLOBAL.SESSION - over the API, as the server does, or at a prompt), and
* the installer ("sd -internal").  Anyone else gets 11028, ADMIN included.
* On a computer with no global password (no $GLOBAL credential) there is nothing
* to manage: it says so, changes nothing, and succeeds, so the installer can
* call it whether or not the computer is managed.
*
* A BAD OBJECT IS REFUSED BY NAME and the rest still go in; the success line
* counts the refusals and the return code is not 0 when there were any.  The
* last line is "sync global catalog done <n> catalogued <n> removed <n>
* refused" - a caller anchors on that.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program syncgcat
$catalog $SYNCGCAT

$include header.h
$include keys.h
$include int$keys.h
$include err.h

   @system.return.code = -ER$ARGS

*  Assigned here for BCOMP (every variable before first use).
   n.cat = 0
   n.rem = 0
   n.bad = 0
   want = ''
   id = ''
   obj = ''
   call.name = ''
   magic = 0

   if not(kernel(K$GLOBAL.SESSION, -1)) and not(kernel(K$INTERNAL, -1)) then
      display sysmsg(11028) ;* The global catalogue can only be changed by the SD Core server
* 07 Oct 26 - the owner's lower-case rule (PAL-24): the audit trail is lower case.
      void kernel(K$AUDIT, 'sync.global.catalog refused - not a global-password session')
      stop
   end

*  No $GLOBAL credential: no SD Core server manages this computer, so nothing to manage.
   managed = @false
   openpath @sdsys : @ds : '$cred' to cred.f then
*     Record ids in the register are lower case on Linux ($global).
      read g.rec from cred.f, '$global' then managed = @true
      close cred.f
   end
   if not(managed) then
      display 'sync.global.catalog: this computer has no global password, so no SD Core server manages it and there is nothing to manage.'
      @system.return.code = 0
      display 'sync global catalog done 0 cataloged 0 removed 0 refused'
      stop
   end

   openpath @sdsys : @ds : 'global.bp.out' to src.f else
      display 'sync.global.catalog: cannot open global.bp.out (' : @sdsys : @ds : 'global.bp.out' : ')'
      stop
   end
   mark.mapping src.f, off

   openpath @sdsys : @ds : 'gcat' to gcat.f else
      stop sysmsg(3022) ;* Cannot open global catalogue directory
   end
   mark.mapping gcat.f, off     ;* object code is read whole (the sweep below tests its magic byte)

   magic = if system(1009) then HDR.MAGIC.NO.B else HDR.MAGIC.NO.L

*  1. Every object in GLOBAL.BP.OUT goes in under its plain name.
   select src.f to 11
   loop
      readnext id from 11 else exit
*     08 Oct 26: catalogue names are LOWER case since PAL-1 stage 3a (7 Oct) - CATALOG
*     lower-cases the name and the loader looks it up lower-cased (valid_call_name
*     accepts lower only).
*     09 Nov 26: the plain name (the * prefix is gone, S.87).  A name that begins with a
*     prefix character would be taken for one of SD's own programs: refused.
      call.name = downcase(id)
      if index('$!_*-', call.name[1, 1], 1) then
         display 'sync.global.catalog: ' : id : ' begins with $ ! _ * or - - refused'
         n.bad += 1
         continue
      end
      read obj from src.f, id else
         display 'sync.global.catalog: ' : id : ' could not be read - refused'
         n.bad += 1
         continue
      end
      if obj[hdr.magic, 1] # char(magic) then
         display sysmsg(3025, id) ;* Invalid object record (xx)
         n.bad += 1
         continue
      end
      if obj[hdr.rev, 1] # char(hdr.revision) then
         display sysmsg(3026, id) ;* Invalid object record revision level in xx
         n.bad += 1
         continue
      end
*     As CATALOG does for a global entry: the header carries the call name.
      obj[hdr.program.name, hdr.program.name.len] = call.name : char(0)
      recordlocku gcat.f, call.name
      mark.mapping gcat.f, off
      deleteu gcat.f, call.name   ;* NTFS keeps an overwritten file's old case (catalog)
      write obj to gcat.f, call.name
      want<-1> = call.name
      n.cat += 1
      display 'cataloged ' : call.name
   repeat
   obj = ''

*  2. Every server entry (no $ ! _ prefix) with no object behind it goes.  Collected
*  first, deleted after, so the select is not walking a directory it is changing.
   gone = ''
   select gcat.f to 12
   loop
      readnext id from 12 else exit
      if not(index('$!_', id[1, 1], 1)) then
*        Only an object record is a catalogue entry: gcat also holds the shipped README,
*        which has no prefix and must stay.
         read obj from gcat.f, id else continue
         if obj[hdr.magic, 1] # char(magic) then continue
*        The stored name, exactly: an UPPER-case entry left by a sync before 8 Oct, or a
*        *name entry left by a sync before 9 Nov, is not in want (plain, lower case), so it
*        goes with the other stale ones.
         locate id in want<1> setting pos else gone<-1> = id
      end
   repeat
   loop
      id = remove(gone, more)
      if id # '' then
         delete gcat.f, id
         n.rem += 1
         display 'removed ' : id
      end
   while more
   repeat

   close src.f
   close gcat.f

   void kernel(K$AUDIT, 'sync.global.catalog ' : n.cat : ' cataloged ' : n.rem : ' removed ' : n.bad : ' refused')
   if n.bad = 0 then @system.return.code = 0
   display 'sync global catalog done ' : n.cat : ' cataloged ' : n.rem : ' removed ' : n.bad : ' refused'
   stop
end

* END-CODE
