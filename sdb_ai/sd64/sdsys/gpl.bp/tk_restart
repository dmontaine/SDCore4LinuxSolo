* START-HISTORY:
* 22 Nov 26 dm  New, from SD Core's tk_restart (S.301; SD Core for Windows' row 382).  The owner: "A dialog specifying why a restart might be needed,
*               warning that everyone will be logged out and giving a Restart|Not now option would be the best", and "it would be better if the screen
*               disappeared and then the message briefly displayed and then turned off".  Differs from Core's where Solo does: SD Core Solo is the
*               user's own systemd unit (sd-solo.service), so the restart is asked of the user's systemd and there is no root helper.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $tk_restart(ctx, why, res, msg)
*
*     ctx   the page's context ($tk_open's): Restart closes the page with it
*     why   why this change needs a restart, one line to a field (the page's own words: which setting, and that SD reads it only when it starts)
*     res   returned: 'later' when Not now was chosen (or Esc, or no terminal); 'failed' when Restart was chosen and SD did not restart.
*           After 'failed' THE PAGE IS CLOSED: the caller opens it again ($tk_open) and draws it.  When the restart works this session is
*           ended with every other, so nothing comes back.
*     msg   returned: the line for the page's status bar
*
*   The box: its title says "Restart SD?", then the command, then why, then that a restart signs out everyone using SD and ends this session too, then
*   what Not now means.  Two buttons, Restart and Not now; NOT NOW IS THE DEFAULT ($tk_confirm's last button is), so Enter alone never restarts SD.
*
*   Restart: the page is closed and the screen cleared, one line says SD is restarting, and the user's systemd is asked to restart sd-solo.service
*   (--no-block: it takes the job and the command returns, because this session is one of those the stop ends).  The command is fixed text: nothing
*   of the caller's reaches it.  It is refused, with a sentence, when the unit is not active (SD started by hand: sd-solo -start).  SUCCESS IS THE
*   COMMAND'S OWN LAST LINE "restart of sd-solo.service asked of systemd" with status 0, nothing else.  Then this waits up to a minute for SD to end
*   the session; if SD has not, or the restart was not taken, it shows why, waits for Enter and returns 'failed'.
*
*   ONE AUDIT LINE each time the restart is asked for:  sd restart app=<the page> status=asked  or  status=refused.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_restart(ctx, why, res, msg)
$catalog $tk_restart

$include keys.h
$include int$keys.h
$include tk.h

$define SYSTEMCTL  'LC_ALL=C systemctl --user'
$define RS.UNIT    'sd-solo.service'

   res = 'later'
   msg = ''

   lines = why
   lines<-1> = 'A restart stops and starts SD and signs out everyone, this session too.'   ;* one line in the box (Windows row 382, the owner: "a dangling word")
   lines<-1> = 'Not now: nothing restarts, and the change takes effect when SD is next started.'
   call $tk_confirm('systemctl --user restart sd-solo.service', lines, '', cres, cmsg, 'Restart SD?', '&Restart,&Not now')
   if cres # 'run' then
      msg = 'SD was not restarted: the change takes effect when SD is next started'
      return
   end

   app = ctx<TK.C.APP>
   call $tk_close(ctx)
   display @(-1) :
   display 'SD is restarting.  Everyone using SD is signed out, and this session ends.'

*  The one step.  Fixed text: no variable of the caller's is in it.  The last line it prints on the way that worked is the anchor below.
   anchor = 'restart of sd-solo.service asked of systemd'
   cmd = 'XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; export XDG_RUNTIME_DIR; '
   cmd := 'if ! ' : SYSTEMCTL : ' is-active --quiet ' : RS.UNIT : '; then echo "' : RS.UNIT : ' is not active: SD was not started by systemd, so it is stopped and started the way it was started (sd-solo -stop, then sd-solo -start)"; exit 3; fi; '
   cmd := SYSTEMCTL : ' restart --no-block ' : RS.UNIT : ' && echo "' : anchor : '"'
   out = ''
   os.execute cmd : ' 2>&1' capturing out
   stat = os.error()

*  Success is the command's own line and nothing else
   asked = @false
   last = ''
   for i = 1 to dcount(out, @fm)
      ln = trim(out<i>)
      if ln # '' then last = ln
      if ln = anchor then asked = @true
   next i
   if stat # 0 then asked = @false
   void kernel(K$AUDIT, 'sd restart app=' : downcase(app) : ' status=' : (if asked then 'asked' else 'refused'))

   why.not = ''
   if asked then
*     systemd is stopping SD: this session is ended with the rest.  It is not drawn again meanwhile.
      for w = 1 to 60
         sleep 1
      next w
      why.not = 'SD did not end this session within a minute.'
   end

   res = 'failed'
   if why.not = '' then why.not = last
   if why.not = '' then why.not = 'systemd gave no answer (status ' : stat : ')'
   display ''
   display 'SD was not restarted.'
   display why.not
   display sysmsg(11865) :                                      ;* Press Enter to return
   input junk
   if junk = char(1) then null                                  ;* any answer goes back; the answer itself is not used
   msg = 'SD was not restarted: ' : why.not
   return
end

* END-CODE
