* ACC_TREE_COUNT
* Count a directory tree the way the archive stores it, SD Core for Linux Solo.
* Copyright (c) String Database
*
* START-HISTORY:
* 02 Oct 26 dm Written for S.50 / LSOLO 20 (shared signature, mail
*              2026-10-01T1030).  Solo's user owns every file in the tree, so
*              the count runs <home>/bin/sd-accarchive directly; the
*              multi-user product counts account directories as root.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    call !acc_tree_count(path, files, bytes, dirs, err)
*
*    Regular files and their bytes, and the directories below path (path
*    itself not counted); symlinks and special files are not counted, because
*    the archive does not store them.  A count that fails is an error (11044),
*    never a zero.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine acc_tree_count(path, files, bytes, dirs, err)
$catalog !acc_tree_count

$include int$keys.h

   files = 0 ; bytes = 0 ; dirs = 0 ; err = ''

   if path = '' or index(path:@sdsys, "'", 1) then
      err = 11043:@vm:path
      return
   end

   out = ''
   os.execute "python3 '":@sdsys:@ds:"bin":@ds:"sd-accarchive' count '":path:"' 2>&1" capturing out
   stat = os.error()

   found = @false
   n = dcount(out, @fm)
   for i = 1 to n
      line = out<i>
      if field(line, ' ', 1) = 'COUNT' and field(line, ' ', 2) = '.' then
         files = field(line, ' ', 3) + 0
         bytes = field(line, ' ', 4) + 0
         dirs = field(line, ' ', 5) + 0
         found = @true
      end
   next i

   if stat # 0 or not(found) then
      files = 0 ; bytes = 0 ; dirs = 0
      err = 11044:@vm:path:@vm:stat:@vm:convert(@fm, '|', out) ;* Counting %1 failed
   end
   return

end

* END-CODE
