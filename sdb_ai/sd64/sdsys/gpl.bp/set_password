* START-HISTORY:
* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - adapted from SD Core Solo for
*           Windows' gpl.bp/set_password (ruling 39, 28 Sep 2026).  Differences:
*           messages are 110nn here (120nn there); $cred record ids are lower
*           case (a case-sensitive filesystem); the one-shot copy is the plain
*           private file of !SOLO_STORE_PW, not DPAPI.
* 30 Sep 26 LSOLO 12 - SET.PASSWORD GLOBAL is allowed to a session holding
*           K$GLOBAL.SESSION (ruling 33), refused to every other (11033).
* 06 Oct 26 LSOLO 38 - there is one install and no "standalone" mode: a
*           computer with no global password says so in 11034 (new text,
*           the same on SD Core Solo for Windows).  Comments only otherwise.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    SET.PASSWORD         the account password
*    SET.PASSWORD ADMIN   the administrator password
*    SET.PASSWORD GLOBAL  the global password (a managed computer's) - see above
*
* RULING 39, owner 28 Sep 2026 (Solo for Windows): "in managed mode global
* should always have the ability to change all passwords, sduser should always
* be able to change the account password, admin should be able to change the
* administrator password".  So:
*
*    account   anyone in the account.  Without ADMIN (K$ADMINISTRATOR) the
*              CURRENT account password is asked first, so an unattended
*              session cannot be taken over by changing it.
*    ADMIN     K$ADMINISTRATOR - ADMIN unlocked, or a global session.
*    GLOBAL    a global session only, and only where a global password exists:
*              ruling 15 - no verb creates or clears it, so a computer with
*              none answers 11034.
*
* It sets the account password of the account this session is IN (@who), and
* only an account in the register - never SDSYS (ruling 11).  The records are
* the account's name, $admin and $global in $cred; !CRED_SET keeps a record's
* own salt on a change, so the account and $global still share one (ruling 19,
* which the API's SCRAM needs).
*
* The new password must be printable ASCII and meet pw_complex, and the global
* password must differ from the other two where it exists (11014 for the
* account against the global, 11035 otherwise; the account and administrator
* passwords may be equal, as the installer has always allowed).
*
* The password is never displayed, stored or logged; the change is audited.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set_password
$catalog $SETPW

$include keys.h
$include int$keys.h
$include err.h

deffun pw_complex(pw) calling '!pw_complex'

   prompt ''
   @system.return.code = -ER$ARGS

   which = upcase(field(trim(@sentence), ' ', 2))
   if which = '' then which = 'ACCOUNT'
   if field(trim(@sentence), ' ', 3) # '' or (which # 'ACCOUNT' and which # 'ADMIN' and which # 'GLOBAL') then
      display 'SET.PASSWORD [ADMIN | GLOBAL]'
      stop
   end

   is.admin = kernel(K$ADMINISTRATOR, -1)

   acc.name = downcase(@who)
   known = @false
   if acc.name # 'sdsys' then
      openpath @sdsys : @ds : 'accounts' to acc.f then
         read acc.rec from acc.f, acc.name then known = @true
         close acc.f
      end
   end
   if not(known) then
      display sysmsg(11015, @who) ;* %1 cannot have an account password
      stop
   end

*  Whether this computer has a global password (ruling 15: the mode IS that).
   has.global = @false
   openpath @sdsys : @ds : '$cred' to cred.f then
      read g.rec from cred.f, '$global' then has.global = @true
      close cred.f
   end

   begin case
      case which = 'ACCOUNT'
         cred.key = upcase(acc.name)
      case which = 'ADMIN'
         if not(is.admin) then
            display sysmsg(2001) ;* Command requires administrator privileges
            stop
         end
         cred.key = '$ADMIN'
      case which = 'GLOBAL'
         if not(has.global) then
            display sysmsg(11034) ;* This computer has no global password - no SD Core server manages it
            stop
         end
*        30 Sep 26 LSOLO 12: only a session signed in with the global password
*        (K$GLOBAL.SESSION) is the SD Core server; ADMIN is not enough.
         if not(kernel(K$GLOBAL.SESSION, -1)) then
            display sysmsg(11033) ;* The global password can only be changed by the SD Core server
            void kernel(K$AUDIT, 'GLOBAL PASSWORD REFUSED - not a global-password session')
            stop
         end
         cred.key = '$GLOBAL'
   end case

*  Ruling 39: the account password without ADMIN asks the CURRENT one first.
   if which = 'ACCOUNT' and not(is.admin) then
      display sysmsg(11031) : ' ' :  ;* Current password:
      input pw0 HIDDEN
      display
      ok0 = @false
      if pw0 # '' then call !CRED_VERIFY(cred.key, pw0, ok0)
      pw0 = ''
      if not(ok0) then
         display sysmsg(11032) ;* Wrong password - the password is unchanged
         void kernel(K$AUDIT, 'ACCOUNT PASSWORD REFUSED account=' : acc.name : ' - wrong current password')
         stop
      end
   end

   display sysmsg(11009) : ' ' :  ;* New password:
   input pw1 HIDDEN
   display
   display sysmsg(11010) : ' ' :  ;* Confirm the new password:
   input pw2 HIDDEN
   display

   if pw1 = '' or pw1 # pw2 then
      pw1 = '' ; pw2 = ''
      display sysmsg(11011) ;* The passwords do not match - the password is unchanged
      stop
   end
   pw2 = ''

   for i = 1 to len(pw1)
      c = seq(pw1[i,1])
      if c < 33 or c > 126 then
         pw1 = ''
         display sysmsg(11013) ;* Use letters, digits and punctuation only - the password is unchanged
         stop
      end
   next i

   if not(pw_complex(pw1)) then
      pw1 = ''
      display sysmsg(10920) ;* A password needs at least 8 characters, with a lower-case letter...
      stop
   end

*  The global must differ from the other two.  CRED_VERIFY fails closed on a
*  missing record, so a password that does not exist (no global password: no $global)
*  never matches.  Ruling 19 for the account against the global (11014); the
*  installer's rule for the other pairs (11035).
   same = @false
   begin case
      case which = 'ACCOUNT'
         call !CRED_VERIFY('$GLOBAL', pw1, same)
         if same then
            pw1 = ''
            display sysmsg(11014) ;* The account password must differ from the global password
            stop
         end
      case which = 'ADMIN'
         call !CRED_VERIFY('$GLOBAL', pw1, same)
   end case
   if same then
      pw1 = ''
      display sysmsg(11035) ;* The global password must differ from the account and administrator passwords
      stop
   end

   stored = @false
   call !CRED_SET(cred.key, pw1, stored)
   if not(stored) then
      pw1 = ''
      display sysmsg(11016, status()) ;* The password could not be stored (status %1)
      stop
   end

*  Rewrite the kept copy that one-shot commands use (ruling 21, "updates
*  automatically").  The password HAS changed by now, so a failure here is
*  reported but does not undo it: a stale copy no longer verifies, and login
*  then reads the one-shot's input instead.  The account password only - the
*  kept copy never holds the other two.
   kept = @true
   if which = 'ACCOUNT' then
      kept = @false
      call !SOLO_STORE_PW(upcase(acc.name), pw1, kept)
   end
   pw1 = ''

   begin case
      case which = 'ACCOUNT' ; void kernel(K$AUDIT, 'ACCOUNT PASSWORD SET account=' : acc.name)
      case which = 'ADMIN'   ; void kernel(K$AUDIT, 'ADMIN PASSWORD SET')
   end case
   @system.return.code = 0
   display sysmsg(11012) ;* Password changed
   if not(kept) then
      display sysmsg(11022, status()) ;* The new password could not be kept for commands given on the sd command line (status %1)
   end
end

* END-CODE
