* START-HISTORY:
* 30 Sep 26 SD Core for Linux Solo (LSOLO 12) - ruling 33: the global password
*           also sets K$GLOBAL.SESSION.
* 29 Sep 26 SD Core for Linux Solo (LSOLO 6) - adapted from SD Core Solo for
*           Windows' gpl.bp/admin (SOLO 5).  Messages are 11002-11007 here
*           (12002-12007 there).
* END-HISTORY
*
* START-DESCRIPTION:
*
*    ADMIN          ask for the administrator password; unlock on a match
*    ADMIN OFF      lock again
*
* Owner's ruling 12 (Solo for Windows, 25 Sep 2026): the administrator commands
* are gated by an administrator password set at install; in managed mode (b) the
* global password unlocks them too.  Ruling 15: the mode is fixed at install,
* and the mode IS whether a global password was set - there is no other flag.
*
* WHAT "UNLOCKED" MEANS IS THE FLAG THE ADMINISTRATOR COMMANDS ALREADY TEST.
* Programs gate on K$ADMINISTRATOR; nothing seeds it for an ordinary session
* (sd no longer runs as root or as an sdsys user), so this verb is the one way
* a session gets it.  Only a $internal program may set it (op_kernel.c,
* K_ADMINISTRATOR), which is why this one is.  It lasts until ADMIN OFF or the
* end of the session.
*
* THE PASSWORDS are SCRAM verifiers in $cred under $ADMIN and $GLOBAL, names no
* account can have (an account name starts with a letter), written at install
* by gpl.bp/solo_password through !CRED_SET and checked here by !CRED_VERIFY.
* No record, no unlock: CRED_VERIFY fails closed on a missing record.
*
* Every attempt is audited, unlocked or refused.  The password is never
* displayed, stored or logged.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program admin
$catalog $ADMIN

$include keys.h
$include int$keys.h
$include err.h

   prompt ''
   @system.return.code = -ER$ARGS

   arg = upcase(trim(field(trim(@sentence), ' ', 2)))

   if arg = 'OFF' then
      void kernel(K$ADMINISTRATOR, 0)
* 07 Oct 26 - the owner's lower-case rule (PAL-24): the whole audit trail is lower case.
      void kernel(K$AUDIT, 'admin locked')
      display sysmsg(11004) ;* Administrator commands locked
      @system.return.code = 0
      stop
   end

   if arg # '' then
      display 'admin takes no argument but off.'
      stop
   end

   if kernel(K$ADMINISTRATOR, -1) then
      display sysmsg(11006) ;* Administrator commands are already unlocked
      @system.return.code = 0
      stop
   end

*  Is there anything to check against?  Said plainly rather than letting every
*  password be "wrong" on a system that was installed without one.
   has.admin = @false
   openpath @sdsys : @ds : '$cred' to cred.f then
*     LOWER CASE, as !CRED_SET stores it: $cred is a directory file on a
*     case-sensitive filesystem, so '$ADMIN' is not the record '$admin' that
*     solo_password wrote.  (Solo for Windows reads '$ADMIN'; NTFS folds it.)
      read cred.rec from cred.f, '$admin' then has.admin = @true
      close cred.f
   end
   if not(has.admin) then
      display sysmsg(11007) ;* No administrator password is set on this system
      void kernel(K$AUDIT, 'admin refused reason=no $ADMIN credential')
      stop
   end

   display sysmsg(11002) : ' ' :   ;* Administrator password:
   input pw HIDDEN

   ok = @false
   call !CRED_VERIFY('$ADMIN', pw, ok)
   via = 'admin'
   if not(ok) then
*     A managed computer (b): the global password is the other key (ruling 12).
*     With no global password there is no $GLOBAL record and CRED_VERIFY says no.
      call !CRED_VERIFY('$GLOBAL', pw, ok)
      via = 'global'
   end
   pw = ''

   if not(ok) then
      sleep 2
      display sysmsg(11005) ;* Wrong password - administrator commands stay locked
      void kernel(K$AUDIT, 'admin refused reason=wrong password')
      stop
   end

*  TAKE THE ANSWER, as LOGIN does: the key reports the flag as it stands, so a
*  grant that did not happen cannot be reported as one.
   granted = kernel(K$ADMINISTRATOR, 1)
   if not(granted) then
      display sysmsg(11005)
      void kernel(K$AUDIT, 'admin refused reason=the flag was not granted')
      stop
   end

*  30 Sep 26 - ruling 33: the global password also marks the session as a
*  $GLOBAL one (K$GLOBAL.SESSION); the administrator password does not.
   if via = 'global' then void kernel(K$GLOBAL.SESSION, 1)
   void kernel(K$AUDIT, 'admin unlocked via=' : via)
   display sysmsg(11003) ;* Administrator commands unlocked for this session
   @system.return.code = 0
   stop
end

* END-CODE
